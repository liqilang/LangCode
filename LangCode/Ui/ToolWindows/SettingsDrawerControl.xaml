<UserControl x:Class="LangCode.Ui.ToolWindows.SettingsDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:LangCode.Ui.Primitive">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 调色板由 ThemeManager.Attach(this) 注入（同一可变字典实例，随 VS 主题实时刷新） -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LangCode;component/Ui/Theme/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LinkRow"
                   TargetType="Button">
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Ap.Divider}"
                                    BorderThickness="0,0,0,1"
                                    Padding="2,10">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="{DynamicResource Ap.BgHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RangeValue"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource TdMono}">
                <Setter Property="Width"
                        Value="40"/>
                <Setter Property="TextAlignment"
                        Value="Right"/>
                <Setter Property="VerticalAlignment"
                        Value="Center"/>
                <Setter Property="Margin"
                        Value="10,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root"
          Background="{DynamicResource Ap.BgElevated}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide"
                                X="0"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 抽屉头 -->
        <Border Grid.Row="0"
                Background="{DynamicResource Ap.BgElevated}"
                BorderBrush="{DynamicResource Ap.BorderSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="6,0,8,0">
                <Button x:Name="BtnBack"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="返回"
                        Click="Back_Click"
                        ToolTip="返回">
                    <ui:Icon IconName="chevron-left"
                             Width="16"
                             Height="16"/>
                </Button>
                <TextBlock Text="设置"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Ap.FgBright}"
                           VerticalAlignment="Center"
                           Margin="34,0,0,0"/>
                <!--
                    保存：本页所有改动都先进「草稿」，只有点这里才写回并生效
                    右侧常驻红点提示「有未保存的改动」，点返回时也会拦一下
                -->
                <Button x:Name="BtnSave"
                        Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Height="26"
                        Padding="12,0"
                        Content="保存"
                        Click="Save_Click"
                        ToolTip="保存并关闭（未保存前改动不会生效）"/>
            </Grid>
        </Border>

        <!--
                设置搜索：设置项一多，"能搜"比"能翻"更重要
                命中即显、未命中即收起；清空关键字全部恢复（见 SettingsSearch_TextChanged）
        -->
        <Border Grid.Row="1"
                Background="{DynamicResource Ap.BgElevated}"
                BorderBrush="{DynamicResource Ap.BorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <TextBox x:Name="SettingsSearch"
                         Style="{StaticResource SearchInput}"
                         TextChanged="SettingsSearch_TextChanged"/>
                <ui:Icon IconName="search"
                         Width="14"
                         Height="14"
                         Foreground="{DynamicResource Ap.FgFaint}"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="9,0,0,0"
                         IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!--
                分页导航放在**左侧**、内容在右：
                设置项越加越多，顶部横排很快就不够排；纵向排在窄窗口里也不会被压扁，
                以后往里加分组也更从容
        -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Ap.BgElevated}"
                    BorderBrush="{DynamicResource Ap.BorderSoft}"
                    BorderThickness="0,0,1,0">
                <StackPanel x:Name="TabsBar"
                            Orientation="Vertical"
                            Margin="6,8,10,8">
                    <RadioButton x:Name="TabGeneral"
                                 Style="{StaticResource TabButton}"
                                 Margin="0,0,0,10"
                                 GroupName="LangCodeSettingsTabs"
                                 Tag="general"
                                 IsChecked="True"
                                 Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon IconName="settings"
                                     Width="13"
                                     Height="13"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="通用"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabApi"
                                 Style="{StaticResource TabButton}"
                                 Margin="0,0,0,10"
                                 GroupName="LangCodeSettingsTabs"
                                 Tag="api"
                                 Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon IconName="link"
                                     Width="13"
                                     Height="13"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="API"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabApproval"
                                 Style="{StaticResource TabButton}"
                                 Margin="0,0,0,10"
                                 GroupName="LangCodeSettingsTabs"
                                 Tag="approval"
                                 Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon IconName="check"
                                     Width="13"
                                     Height="13"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="批准"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <!--
                        「高级」不再是一页塞到底：编辑器 / 自动化 / 能力 / 上下文 / 数据 各占一页，
                        设置项再多也不会堆在同一块滚动区里找不着
                    -->
                    <RadioButton x:Name="TabEditor"
                                 Style="{StaticResource TabButton}"
                                 Margin="0,0,0,10"
                                 GroupName="LangCodeSettingsTabs"
                                 Tag="editor"
                                 Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon IconName="edit"
                                     Width="13"
                                     Height="13"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="编辑器"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabAutomation"
                                 Style="{StaticResource TabButton}"
                                 Margin="0,0,0,10"
                                 GroupName="LangCodeSettingsTabs"
                                 Tag="automation"
                                 Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon IconName="zap"
                                     Width="13"
                                     Height="13"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="自动化"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabCapabilities"
                                 Style="{StaticResource TabButton}"
                                 Margin="0,0,0,10"
                                 GroupName="LangCodeSettingsTabs"
                                 Tag="capabilities"
                                 Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon IconName="sliders"
                                     Width="13"
                                     Height="13"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="能力"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabContext"
                                 Style="{StaticResource TabButton}"
                                 Margin="0,0,0,10"
                                 GroupName="LangCodeSettingsTabs"
                                 Tag="context"
                                 Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon IconName="book"
                                     Width="13"
                                     Height="13"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="上下文"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabData"
                                 Style="{StaticResource TabButton}"
                                 Margin="0,0,0,10"
                                 GroupName="LangCodeSettingsTabs"
                                 Tag="data"
                                 Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon IconName="folder"
                                     Width="13"
                                     Height="13"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="数据"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1"
                          x:Name="PanelsScroll"
                          VerticalScrollBarVisibility="Auto"
                          Padding="14,16,14,26">
                <Grid>

                    <!-- ══════ 通用 ══════ -->
                    <StackPanel x:Name="GeneralPanel">
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="外观"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>

                            <!--
                                设置项统一「左标题 / 右内容」两栏：标签靠左对齐成一条线，控件放右列 ——
                                比「标题一行、控件一行」省一半纵向空间，也更容易把「名字」与「可调项」对上
                                Tag = AppSettings 的属性名：回填与写回由代码按 Tag 反射完成
                                （Tagged<T>() 深度优先遍历整棵子树，因此嵌套进 Grid 照样生效）
                            -->
                            <!--
                                这里刻意**没有**「主题」项：本扩展始终跟随 Visual Studio 的深色 / 浅色主题
                                （见 Ui/Theme/ThemeManager.cs），不提供用户侧覆盖，避免出现「插件主题与 IDE 打架」
                            -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="界面语言"
                                           Style="{StaticResource TdFieldLabel}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <ComboBox Grid.Column="1"
                                          Tag="Language"
                                          MinWidth="150"
                                          SelectedIndex="0"
                                          SelectionChanged="Option_Changed">
                                    <ComboBoxItem Content="简体中文"/>
                                </ComboBox>
                            </Grid>

                            <StackPanel>
                                <TextBlock Text="字号"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SetFontSize"
                                            Grid.Column="0"
                                            Minimum="11"
                                            Maximum="16"
                                            TickFrequency="1"
                                            SmallChange="1"
                                            Value="13"
                                            ValueChanged="Range_Changed"/>
                                    <TextBlock x:Name="FontSizeVal"
                                               Grid.Column="1"
                                               Text="13px"
                                               Style="{StaticResource RangeValue}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="行为"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>

                            <!--
                                「自动批准文件编辑 / 终端命令」不在这里重复出现：
                                它们统一归「批准」分页按类别管理
                                同一个开关摆在两个分页里，用户只会怀疑「我改的到底是哪一个」
                        -->

                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="显示思考过程"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="每一步一行「思考中」，点一下展开看内容（默认收起）"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="ShowThinking"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="思考时自动展开"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="默认关闭：推理内容一律折叠，不抢正文位置；打开后思考过程中会摊开"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="ExpandThinking"
                                              IsChecked="False"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="长文默认折叠"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="超过阈值的代码与文件内容自动折叠，点击展开"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="CollapseLongText"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="桌面通知"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="任务完成或需要确认时发送系统通知"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="DesktopNotifications"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="跟随 AI 打开文件"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="AI 读文件时在编辑器里打开；修改文件时打开 VS 的差异对比"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="FollowFileChanges"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- ══════ API ══════ -->
                    <StackPanel x:Name="ApiPanel"
                                Visibility="Collapsed">
                        <!--
                                ══════ 配置档案 ══════
                                用户自己命名的多套连接（AA = OpenAI、BB = GLM …）
                                配好下面「连接 / 模型参数」后起个名字存下来，之后在主页的选模型弹层里一键切换
                        -->
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="配置档案"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>

                            <TextBlock Text="名称"
                                       Style="{StaticResource TdFieldHint}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SetProfileName"
                                          Grid.Column="0"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          ToolTip="选择已有配置名，或直接输入新名字（例如 AA）"/>
                                <Button x:Name="BtnProfileSave"
                                        Grid.Column="1"
                                        Style="{StaticResource IconButton}"
                                        Width="30"
                                        Height="30"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="ProfileSave_Click"
                                        ToolTip="保存为新档案（把当前 API 提供商 / Key / Base URL / 模型存成这套档案）">
                                    <ui:Icon IconName="plus"
                                             Width="15"
                                             Height="15"/>
                                </Button>
                            </Grid>

                            <StackPanel x:Name="ProfileRows"/>
                            <TextBlock x:Name="ProfileEmptyHint"
                                       Text="还没有命名档案先配好下面的「连接」与「模型参数」，再起个名字（留空则用当前模型名）点 + 保存"
                                       Style="{StaticResource TdFieldHint}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="连接"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>

                            <TextBlock Text="API 提供商"
                                       Style="{StaticResource TdFieldLabel}"
                                       Margin="0,0,0,5"/>
                            <!-- 选项来自 ModelCatalog.Providers；下拉可输入  -->
                            <ComboBox x:Name="SetProvider"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      Margin="0,0,0,12"
                                      SelectionChanged="Provider_Changed"/>

                            <!-- 校验错误条  -->
                            <Border x:Name="ApiErrorBar"
                                    Visibility="Collapsed"
                                    CornerRadius="6"
                                    Margin="0,0,0,12"
                                    Padding="10,8"
                                    Background="#22F48771"
                                    BorderBrush="#66F48771"
                                    BorderThickness="1">
                                <TextBlock x:Name="ApiErrorText"
                                           Foreground="{DynamicResource Ap.Red}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!--
                                提供商专属字段 ：
                                Base URL / 「使用自定义 Base URL」勾选 / API Key（含「获取」链接）/ 额外字段；
                                全部由代码按 ProviderFormSpec 动态生成（RenderProviderFields）
                            -->
                            <StackPanel x:Name="ProviderFieldsPanel"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="模型参数"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="默认模型"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <!--
                                随「API 提供商」联动（由代码填充）
                                IsEditable：列表里没有最新型号时，用户可以直接手输 model id
                            -->
                                <ComboBox x:Name="SetModel"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          SelectionChanged="Model_Changed"
                                          PreviewKeyDown="Model_PreviewKeyDown"
                                          LostFocus="Model_TextCommitted"/>
                                <!-- 模型信息（上下文 / 最大输出 / 单价），由代码按 ModelInfo 回填 -->
                                <TextBlock x:Name="ModelInfoLine"
                                           Text=" "
                                           Style="{StaticResource TdFieldHint}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="最大输出"
                                               Style="{StaticResource TdFieldLabel}"
                                               Margin="0,0,0,5"/>
                                    <!-- Tag = AppSettings 属性名：由声明式绑定回填/写回 -->
                                    <TextBox Style="{StaticResource FieldControl}"
                                             Tag="MaxOutputTokens"
                                             TextChanged="TextOption_Changed"
                                             Text="8192"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="上下文窗口"
                                               Style="{StaticResource TdFieldLabel}"
                                               Margin="0,0,0,5"/>
                                    <!-- 档位由代码填充；选中模型后会自动对上该模型的上下文窗口 -->
                                    <ComboBox x:Name="SetCtxWindow"
                                              SelectionChanged="ContextWindow_Changed"/>
                                </StackPanel>
                            </Grid>

                            <!-- 温度 / Top P 已移入下方「高级设置」  -->
                        </StackPanel>

                        <!--
                            ══════ 模型高级选项 ══════
                             「模型高级选项」：推理强度 / 回答详细度 / 思考预算
                            一律「留空或 0 = 不带该字段」，默认完全不影响兼容性；只有用户显式设置才发送
                        -->
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="模型高级选项"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>
                            <TextBlock Text="按当前提供商生效留空 / 为 0 时不发送对应字段，兼容性最好"
                                       Style="{StaticResource TdFieldHint}"
                                       Margin="0,0,0,9"
                                       TextWrapping="Wrap"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="推理强度"
                                               Style="{StaticResource TdFieldLabel}"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="SetReasoningEffort"
                                              SelectionChanged="AdvancedOption_Changed">
                                        <ComboBoxItem Content="默认"
                                                      Tag=""/>
                                        <ComboBoxItem Content="最低 (minimal)"
                                                      Tag="minimal"/>
                                        <ComboBoxItem Content="低 (low)"
                                                      Tag="low"/>
                                        <ComboBoxItem Content="中 (medium)"
                                                      Tag="medium"/>
                                        <ComboBoxItem Content="高 (high)"
                                                      Tag="high"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="回答详细度"
                                               Style="{StaticResource TdFieldLabel}"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="SetVerbosity"
                                              SelectionChanged="AdvancedOption_Changed">
                                        <ComboBoxItem Content="默认"
                                                      Tag=""/>
                                        <ComboBoxItem Content="简洁 (low)"
                                                      Tag="low"/>
                                        <ComboBoxItem Content="适中 (medium)"
                                                      Tag="medium"/>
                                        <ComboBoxItem Content="详尽 (high)"
                                                      Tag="high"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <TextBlock Text="思考预算（token）"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource FieldControl}"
                                         Tag="ThinkingBudgetTokens"
                                         TextChanged="TextOption_Changed"
                                         Text="0"/>
                                <TextBlock Text="0 = 不指定；大于 0 时对支持的端点注入 thinking.budget_tokens"
                                           Style="{StaticResource TdFieldHint}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!--
                            ══════ 高级设置（默认折叠）══════
                             Advanced Settings：温度 / Top P / 速率限制都收在这里
                        -->
                        <Expander Margin="0,0,0,10"
                                  IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="高级设置"
                                           Style="{StaticResource TdSectionTitle}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="温度（Temperature）"
                                               Style="{StaticResource TdFieldLabel}"
                                               Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SetTemp"
                                                Grid.Column="0"
                                                Minimum="0"
                                                Maximum="1"
                                                TickFrequency="0.05"
                                                SmallChange="0.05"
                                                LargeChange="0.05"
                                                Value="0.2"
                                                ValueChanged="Range_Changed"/>
                                        <TextBlock x:Name="TempVal"
                                                   Grid.Column="1"
                                                   Text="0.20"
                                                   Style="{StaticResource RangeValue}"/>
                                    </Grid>
                                    <TextBlock Text="越低越稳定严谨，越高越有创造性写代码建议 0.1 ~ 0.3"
                                               Style="{StaticResource TdFieldHint}"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Top P"
                                               Style="{StaticResource TdFieldLabel}"
                                               Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SetTopP"
                                                Grid.Column="0"
                                                Minimum="0"
                                                Maximum="1"
                                                TickFrequency="0.05"
                                                SmallChange="0.05"
                                                LargeChange="0.05"
                                                Value="1"
                                                ValueChanged="Range_Changed"/>
                                        <TextBlock x:Name="TopPVal"
                                                   Grid.Column="1"
                                                   Text="1.00"
                                                   Style="{StaticResource RangeValue}"/>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,10,0">
                                        <TextBlock Text="请求限流"
                                                   Style="{StaticResource TdToggleName}"/>
                                        <TextBlock Text="限制每分钟的 API 请求数量，避免触发风控"
                                                   Style="{StaticResource TdToggleDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource Switch}"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,10,0">
                                        <TextBlock Text="失败自动重试"
                                                   Style="{StaticResource TdToggleName}"/>
                                        <TextBlock Text="网络错误时最多重试 3 次，采用指数退避"
                                                   Style="{StaticResource TdToggleDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource Switch}"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- ══════ 批准 ══════ -->
                    <StackPanel x:Name="ApprovalPanel"
                                Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="按类别自动批准"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>
                            <TextBlock Text="开关打开 = 这类操作不再询问，直接执行关掉之后，每次都会先出确认卡等你点「接受 / 拒绝」"
                                       Style="{StaticResource TdFieldHint}"
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap"/>

                            <!-- 行由 ApprovalCatalog 在代码里生成（与输入框的 Auto 弹层共用同一份定义） -->
                            <StackPanel x:Name="ApprovalList"/>
                        </StackPanel>
                    </StackPanel>



                    <!-- ══════ 编辑器 ══════ -->
                    <StackPanel x:Name="EditorPanel"
                                Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="编辑器集成"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>

                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="检查点（Checkpoints）"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="每次修改后创建可回滚的快照，占用少量磁盘空间"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="Checkpoints"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 「浏览器操作」的批准开关在「批准」分页里，这里不重复 -->

                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="自动读取问题面板"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="把编辑器中的诊断错误作为上下文一并发送"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="AutoReadProblems"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="保存时自动格式化"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="LangCode 修改文件后调用编辑器的格式化命令"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="FormatOnSave"
                                              IsChecked="False"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>

                    <!-- ══════ 自动化 ══════ -->
                    <StackPanel x:Name="AutomationPanel"
                                Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="自动化"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>

                            <!-- 项目规则：AGENTS.md / .langcoderules / .langcode/rules/*.md 自动注入系统提示词 -->
                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="项目规则文件"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="自动读取 AGENTS.md / .langcoderules / .langcode/rules/*.md 并注入每次请求"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="UseProjectRules"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 自动上下文：当前文件 / 编辑器选中代码 / 编译诊断 -->
                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="自动附带上下文"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="发送前自动带上当前文件、编辑器选中代码与编译诊断"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="AutoContext"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 自动修复：改完文件后读「错误列表」，有错误就回灌给模型继续修 -->
                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="自动修复编译问题"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="改完文件后读取「错误列表」，若有错误自动回灌给模型继续修复"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="AutoFixProblems"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="自动修复轮次上限"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource FieldControl}"
                                         Tag="AutoFixMaxRounds"
                                         TextChanged="TextOption_Changed"
                                         Text="2"/>
                                <TextBlock Text="最多自动回灌几轮，防止反复修不好的问题把任务拖长"
                                           Style="{StaticResource TdFieldHint}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- 验证循环：改完文件后自动跑一次构建 / 测试，把结果回灌 -->
                            <Grid Margin="0,14,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="自动运行验证命令"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="有文件改动时自动执行下面的命令，并把输出回灌给模型"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="AutoVerify"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="验证命令"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource FieldControl}"
                                         Tag="VerifyCommand"
                                         TextChanged="TextOption_Changed"
                                         Text=""/>
                                <TextBlock Text="留空则自动探测：.NET → dotnet build、Node → npm test/build、Python → pytest、Rust → cargo check、Go → go build危险命令仍会被安全策略拦截"
                                           Style="{StaticResource TdFieldHint}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 高级能力：语义索引 / 结构化编辑 / 浏览器自动化 / 多模态图片 -->
                    </StackPanel>

                    <!-- ══════ 能力 ══════ -->
                    <StackPanel x:Name="CapabilitiesPanel"
                                Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="高级能力"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>
                            <TextBlock Text="以下能力默认开启且自动探测，通常无需手动配置；需要时可在此关闭"
                                       Style="{StaticResource TdFieldHint}"
                                       Margin="0,0,0,4"
                                       TextWrapping="Wrap"/>

                            <!-- 语义索引 / RAG：本地分块 + BM25 检索（semantic_search 等工具） -->
                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="代码库语义索引"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="本地建立语义索引，支持 semantic_search / 继承图查询（关闭后这些工具不可用）"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="SemanticIndex"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="语义检索返回片段数"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource FieldControl}"
                                         Tag="SemanticSearchResults"
                                         TextChanged="TextOption_Changed"
                                         Text="8"/>
                                <TextBlock Text="semantic_search 默认返回多少段最相关的代码片段"
                                           Style="{StaticResource TdFieldHint}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- 结构化编辑：按符号名定位代码块再改写（edit_symbol） -->
                            <Grid Margin="0,14,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="结构化编辑"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="允许按符号名 / 括号锚点定位代码块改写（edit_symbol），比字符串替换更抗格式漂移"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="StructuredEditing"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 浏览器自动化：DevTools 协议驱动（browser_action） -->
                            <Grid Margin="0,14,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="浏览器自动化"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="用 DevTools 协议做导航 / 点击 / 填表 / 截图 / 读 console（browser_action）"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="BrowserAutomation"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="无头模式"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="浏览器在后台运行（不弹窗口）；做前端自测时建议开启"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="BrowserHeadless"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="浏览器可执行文件路径"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource FieldControl}"
                                         Tag="BrowserExecutablePath"
                                         TextChanged="TextOption_Changed"
                                         Text=""/>
                                <TextBlock Text="留空则自动探测 Edge / Chrome 的默认安装位置"
                                           Style="{StaticResource TdFieldHint}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="调试端口"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource FieldControl}"
                                         Tag="BrowserRemoteDebuggingPort"
                                         TextChanged="TextOption_Changed"
                                         Text="9222"/>
                                <TextBlock Text="DevTools 远程调试端口；已有同端口调试实例时直接复用，被占用时自动换空闲端口"
                                           Style="{StaticResource TdFieldHint}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 多模态：粘贴图片随消息发给视觉模型 -->
                            <Grid Margin="0,14,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="多模态图片输入"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="允许在输入框粘贴截图 / 设计稿，随消息以 image_url 发给视觉模型"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="Multimodal"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="单条消息最多图片数"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource FieldControl}"
                                         Tag="MaxImagesPerMessage"
                                         TextChanged="TextOption_Changed"
                                         Text="4"/>
                                <TextBlock Text="防止一次贴太多图片把上下文顶爆"
                                           Style="{StaticResource TdFieldHint}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- 提示缓存：稳定前缀打 cache_control（Anthropic）/ 隐式缓存（OpenAI），重复前缀按折扣价计费 -->
                            <Grid Margin="0,14,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="提示缓存"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="为稳定前缀标记缓存（Anthropic cache_control / OpenAI 隐式缓存），重复上下文按更低折扣计费"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="PromptCaching"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>

                    <!-- ══════ 上下文 ══════ -->
                    <StackPanel x:Name="ContextPanel"
                                Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="自定义指令"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>
                            <TextBox Style="{StaticResource FieldControl}"
                                     Height="Auto"
                                     MinHeight="74"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="9,7"
                                     Tag="CustomInstructions"
                                     TextChanged="TextOption_Changed"
                                     Text=""/>
                            <TextBlock Text="这些指令会附加到每次系统提示中，用于统一代码风格"
                                       Style="{StaticResource TdFieldHint}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="上下文管理"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="自动压缩阈值"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <ComboBox Tag="AutoCompactThreshold"
                                          SelectedIndex="1"
                                          SelectionChanged="Option_Changed">
                                    <ComboBoxItem Content="70%"/>
                                    <ComboBoxItem Content="80%"/>
                                    <ComboBoxItem Content="90%"/>
                                    <ComboBoxItem Content="关闭"/>
                                </ComboBox>
                                <TextBlock Text="上下文占用超过阈值时，自动摘要较早的对话内容"
                                           Style="{StaticResource TdFieldHint}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="单次最大读取文件数"
                                           Style="{StaticResource TdFieldLabel}"
                                           Margin="0,0,0,5"/>
                                <!-- 非数字输入会被忽略（不会把设置写成 0）——见 WriteOption 的类型判断 -->
                                <TextBox Style="{StaticResource FieldControl}"
                                         Tag="MaxFilesPerRead"
                                         TextChanged="TextOption_Changed"
                                         Text="20"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>

                    <!-- ══════ 数据 ══════ -->
                    <StackPanel x:Name="DataPanel"
                                Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="数据与隐私"
                                       Style="{StaticResource TdSectionTitle}"
                                       Margin="0,0,0,9"/>
                            <!--
        「匿名使用统计」的开关已移除：本扩展目前不发送任何遥测数据，
        摆一个永远不会生效的开关只会让人以为自己在被统计
-->


                            <Grid Margin="0,9,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="本地会话记录"
                                               Style="{StaticResource TdToggleName}"/>
                                    <TextBlock Text="将会话历史保存在本地，可在历史记录中查看"
                                               Style="{StaticResource TdToggleDesc}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Switch}"
                                              Tag="LocalSessionHistory"
                                              IsChecked="True"
                                              Click="Switch_Click"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!--
                            任务步数上限：0 = 不限制（默认）
                            以前这里在代码里硬编码 8 步，任务稍长一点就会「做到一半停下」，
                            用户看到的是「没做完」而不是「有保护」
                        -->
                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="任务步数上限"
                                           Style="{StaticResource TdToggleName}"/>
                                <TextBlock Text="一轮任务内最多允许的「模型 → 工具」往返次数0 = 不限制（默认，随时可用取消中断）；想收紧时填一个正数"
                                           Style="{StaticResource TdToggleDesc}"/>
                                <TextBox Style="{StaticResource FieldControl}"
                                         Tag="MaxAgentSteps"
                                         TextChanged="TextOption_Changed"
                                         Margin="0,6,0,0"
                                         Text="0"/>
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource BtnSmall}"
                                        Content="导出设置"
                                        Click="Export_Click"
                                        ToolTip="把当前设置导出成 JSON 文件"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource BtnSmall}"
                                        Content="导入设置"
                                        Click="Import_Click"
                                        ToolTip="从 JSON 文件导入设置（覆盖当前全部设置）"/>
                                <Button Grid.Column="4"
                                        Style="{StaticResource BtnDanger}"
                                        Height="24"
                                        Padding="9,0"
                                        Content="重置全部"
                                        Click="Reset_Click"
                                        ToolTip="恢复出厂设置（会先确认）"/>
                            </Grid>

                            <!--
                                调试信息：记录最近的模型请求与原始流式返回，
                                用于排查「OpenAI Compatible 自定义模型看不到推理过程」这类问题
                            -->
                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="调试信息"
                                           Style="{StaticResource TdToggleName}"/>
                                <TextBlock Text="记录最近的模型请求、原始流式返回与推理提取结果。遇到问题时先在聊天里复现一次，再回来复制粘贴发回即可。"
                                           Style="{StaticResource TdToggleDesc}"
                                           TextWrapping="Wrap"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource BtnSmall}"
                                            Content="复制调试信息"
                                            Click="CopyDiagnostics_Click"
                                            ToolTip="把最近的调试日志复制到剪贴板"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource BtnSmall}"
                                            Content="清空调试信息"
                                            Click="ClearDiagnostics_Click"
                                            ToolTip="清空内存里的调试日志（复制前建议先清空、复现一次，日志更干净）"/>
                                </Grid>
                                <TextBlock x:Name="DiagnosticsStatus"
                                           Style="{StaticResource TdToggleDesc}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
