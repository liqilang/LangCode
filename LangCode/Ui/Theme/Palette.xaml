<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 
    <!-- ==================== 背景层次（深色 #0F1113 / #17191D / #1E2126） ==================== -->
    <SolidColorBrush x:Key="Ap.Bg"
                     Color="#FF17191D"/>
    <SolidColorBrush x:Key="Ap.BgElevated"
                     Color="#FF1E2126"/>
    <SolidColorBrush x:Key="Ap.BgInput"
                     Color="#FF252931"/>
    <SolidColorBrush x:Key="Ap.BgCard"
                     Color="#FF1E2126"/>
    <SolidColorBrush x:Key="Ap.BgHover"
                     Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Ap.BgActive"
                     Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Ap.FooterBg"
                     Color="#FF191B20"/>
    <SolidColorBrush x:Key="Ap.PanelBg"
                     Color="#FF191B20"/>

    <!-- ==================== 描边 / 分隔线（#2C3138 / #363C45） ==================== -->
    <SolidColorBrush x:Key="Ap.Border"
                     Color="#FF2C3138"/>
    <SolidColorBrush x:Key="Ap.BorderSoft"
                     Color="#FF2C3138"/>
    <SolidColorBrush x:Key="Ap.DividerSoft"
                     Color="#FF2C3138"/>
    <SolidColorBrush x:Key="Ap.Divider"
                     Color="#FF2C3138"/>
    <SolidColorBrush x:Key="Ap.ToolBorder"
                     Color="#FF2C3138"/>
    <SolidColorBrush x:Key="Ap.InputBorder"
                     Color="#FF363C45"/>
    <SolidColorBrush x:Key="Ap.ControlBorder"
                     Color="#FF363C45"/>
    <SolidColorBrush x:Key="Ap.ActBorder"
                     Color="#FF363C45"/>
    <SolidColorBrush x:Key="Ap.PopoverBorder"
                     Color="#FF363C45"/>
    <SolidColorBrush x:Key="Ap.PopoverDivider"
                     Color="#FF2C3138"/>
    <SolidColorBrush x:Key="Ap.ControlBg"
                     Color="#FF252931"/>
    <SolidColorBrush x:Key="Ap.PopoverBg"
                     Color="#FF1E2126"/>
    <SolidColorBrush x:Key="Ap.ToolHeadBg"
                     Color="#FF202329"/>
    <SolidColorBrush x:Key="Ap.ToolHeadHover"
                     Color="#FF252931"/>
    <SolidColorBrush x:Key="Ap.TrackBg"
                     Color="#FF2C3138"/>
    <SolidColorBrush x:Key="Ap.FreeSwatch"
                     Color="#FF6D747E"/>
    <SolidColorBrush x:Key="Ap.DisabledBg"
                     Color="#FF363C45"/>

    <!-- ==================== 文本层次（#E7E9EC / #A3A9B3 / #6D747E） ==================== -->
    <SolidColorBrush x:Key="Ap.Fg"
                     Color="#FFA3A9B3"/>
    <SolidColorBrush x:Key="Ap.FgBright"
                     Color="#FFE7E9EC"/>
    <SolidColorBrush x:Key="Ap.FgDim"
                     Color="#FF8B929C"/>
    <SolidColorBrush x:Key="Ap.FgFaint"
                     Color="#FF6D747E"/>
    <SolidColorBrush x:Key="Ap.FgBody"
                     Color="#FFA3A9B3"/>
    <SolidColorBrush x:Key="Ap.FgLabel"
                     Color="#FFA3A9B3"/>
    <SolidColorBrush x:Key="Ap.FgStrong"
                     Color="#FFE7E9EC"/>
    <SolidColorBrush x:Key="Ap.FgMenu"
                     Color="#FFA3A9B3"/>
    <SolidColorBrush x:Key="Ap.IconMuted"
                     Color="#FF6D747E"/>
    <SolidColorBrush x:Key="Ap.IconDim"
                     Color="#FF6D747E"/>
    <SolidColorBrush x:Key="Ap.IconFaint"
                     Color="#FF6D747E"/>
    <SolidColorBrush x:Key="Ap.White"
                     Color="#FFFFFFFF"/>

    <!-- ==================== 强调色与语义色 ==================== -->
    <!-- 主色：蓝 #5B9DFF（悬停态提亮到 #74AEFF） -->
    <SolidColorBrush x:Key="Ap.Accent"
                     Color="#FF5B9DFF"/>
    <SolidColorBrush x:Key="Ap.AccentHi"
                     Color="#FF4A8CF0"/>
    <!-- 兼容键位：原青色语义（完成/已批准/差异新增）统一映射到主色 -->
    <SolidColorBrush x:Key="Ap.Teal"
                     Color="#FF5B9DFF"/>
    <SolidColorBrush x:Key="Ap.TealText"
                     Color="#FF9CC2FF"/>
    <!-- 危险：低饱和红 #D1716B -->
    <SolidColorBrush x:Key="Ap.Red"
                     Color="#FFD1716B"/>
    <SolidColorBrush x:Key="Ap.RedText"
                     Color="#FFE08A84"/>
    <SolidColorBrush x:Key="Ap.FocusBorder"
                     Color="#FF5B9DFF"/>

    <!--
        审批（暖色提示）：对齐 UIUX 模板的「统一审批区 .appr」
        这是全站唯一的一处暖色 —— 用于把「有一个操作正卡在这里等你拍板」从
        一片冷色灰阶里拎出来键名与 PaletteLight.xaml 一一对应
    -->
    <SolidColorBrush x:Key="Ap.Warn"
                     Color="#FFD6B45E"/>
    <SolidColorBrush x:Key="Ap.WarnText"
                     Color="#FFE0C06E"/>
    <SolidColorBrush x:Key="Ap.WarnSoft"
                     Color="#1AD6B45E"/>
    <SolidColorBrush x:Key="Ap.WarnBorder"
                     Color="#59D6B45E"/>
    <SolidColorBrush x:Key="Ap.WarnPanelBg"
                     Color="#FF221F19"/>
    <SolidColorBrush x:Key="Ap.WarnPanelBorder"
                     Color="#FF3A3320"/>

    <!-- 语义淡底 / 淡描边 -->
    <SolidColorBrush x:Key="Ap.TealSoft"
                     Color="#215B9DFF"/>
    <SolidColorBrush x:Key="Ap.TealSoftWeak"
                     Color="#155B9DFF"/>
    <SolidColorBrush x:Key="Ap.TealBorder"
                     Color="#6B5B9DFF"/>
    <SolidColorBrush x:Key="Ap.TealBorderSoft"
                     Color="#595B9DFF"/>
    <SolidColorBrush x:Key="Ap.RedSoft"
                     Color="#1FD1716B"/>
    <SolidColorBrush x:Key="Ap.RedBorderSoft"
                     Color="#59D1716B"/>
    <SolidColorBrush x:Key="Ap.AccentSoft"
                     Color="#215B9DFF"/>
    <SolidColorBrush x:Key="Ap.AccentSoftWeak"
                     Color="#155B9DFF"/>
    <SolidColorBrush x:Key="Ap.AccentBorder"
                     Color="#6B5B9DFF"/>

    <!-- 完成提示条（改用中性虚线观感：淡底 + 灰描边 + 灰文字） -->
    <SolidColorBrush x:Key="Ap.DoneBg"
                     Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Ap.DoneBorder"
                     Color="#476D747E"/>
    <SolidColorBrush x:Key="Ap.DoneFg"
                     Color="#FFA3A9B3"/>

    <!-- 批注提示 -->
    <SolidColorBrush x:Key="Ap.NoteFg"
                     Color="#FFB9D2F5"/>
    <SolidColorBrush x:Key="Ap.NoteBorder"
                     Color="#405B9DFF"/>

    <!-- 用户气泡 -->
    <SolidColorBrush x:Key="Ap.UserBubble"
                     Color="#FF252931"/>
    <SolidColorBrush x:Key="Ap.UserBubbleBorder"
                     Color="#FF363C45"/>

    <!-- 头像 / 品牌块 -->
    <SolidColorBrush x:Key="Ap.AvatarBg"
                     Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Ap.AvatarFg"
                     Color="#FFA3A9B3"/>

    <!-- ==================== 代码语法高亮（VS Code Dark+ 同款，保留以保证可读性） ==================== -->
    <SolidColorBrush x:Key="Ap.SynKey"
                     Color="#FF569CD6"/>
    <SolidColorBrush x:Key="Ap.SynStr"
                     Color="#FFCE9178"/>
    <SolidColorBrush x:Key="Ap.SynComment"
                     Color="#FF6A9955"/>
    <SolidColorBrush x:Key="Ap.SynFunc"
                     Color="#FFDCDCAA"/>
    <SolidColorBrush x:Key="Ap.SynType"
                     Color="#FF4EC9B0"/>
    <SolidColorBrush x:Key="Ap.SynAttr"
                     Color="#FF9CDCFE"/>
    <SolidColorBrush x:Key="Ap.SynNum"
                     Color="#FFB5CEA8"/>
    <SolidColorBrush x:Key="Ap.SynPlain"
                     Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="Ap.CodeFg"
                     Color="#FF9CDCFE"/>
    <SolidColorBrush x:Key="Ap.InlineCodeFg"
                     Color="#FFD7BA7D"/>
    <SolidColorBrush x:Key="Ap.InlineCodeBg"
                     Color="#12FFFFFF"/>

    <!-- diff 行底色 / 文字：新增=主色淡底，删除=低饱和红淡底 + 删除线 -->
    <SolidColorBrush x:Key="Ap.DiffAddBg"
                     Color="#1F5B9DFF"/>
    <SolidColorBrush x:Key="Ap.DiffAddFg"
                     Color="#FFCFE0FF"/>
    <SolidColorBrush x:Key="Ap.DiffDelBg"
                     Color="#1FD1716B"/>
    <SolidColorBrush x:Key="Ap.DiffDelFg"
                     Color="#FFE0A9A4"/>
    <SolidColorBrush x:Key="Ap.DiffCtxFg"
                     Color="#FF8B929C"/>
    <SolidColorBrush x:Key="Ap.DiffSignFg"
                     Color="#52FFFFFF"/>

    <!-- ==================== 控件补充色（原定义在 Controls.xaml，现统一到调色板以便随主题切换） ==================== -->
    <SolidColorBrush x:Key="Ap.SwitchOff"
                     Color="#FF4A4A4D"/>
    <SolidColorBrush x:Key="Ap.ScrollThumb"
                     Color="#59797979"/>
    <SolidColorBrush x:Key="Ap.ScrollThumbHover"
                     Color="#99797979"/>
    <SolidColorBrush x:Key="Ap.ComboItemHover"
                     Color="#FF2F2F31"/>
    <SolidColorBrush x:Key="Ap.ComboItemSelected"
                     Color="#1F5B9DFF"/>

    <!-- ==================== 圆角档位（设计稿：3 / 4 / 5 / 6 / 7 / 8 / 10） ==================== -->
    <CornerRadius x:Key="Ap.RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="Ap.RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="Ap.RadiusChip">5</CornerRadius>
    <CornerRadius x:Key="Ap.RadiusCard">7</CornerRadius>
    <CornerRadius x:Key="Ap.RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="Ap.RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="Ap.RadiusXl">10</CornerRadius>

    <!-- ==================== 字体 ==================== -->
    <FontFamily x:Key="Ap.FontUi">Microsoft YaHei UI, Segoe UI, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="Ap.FontCode">Cascadia Mono, Consolas, Courier New</FontFamily>

</ResourceDictionary>
