<UserControl x:Class="LangCode.VsExt.Ui.ToolWindows.AgentToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:LangCode.VsExt.Ui.Controls"
             xmlns:prim="clr-namespace:LangCode.VsExt.Ui.Primitive"
             xmlns:tw="clr-namespace:LangCode.VsExt.Ui.ToolWindows"
             xmlns:models="clr-namespace:LangCode.VsExt.Domain.Chat"
             MinWidth="320">

        <UserControl.Resources>
                <ResourceDictionary>
                        <!--
                                调色板（Ap.*）不在这里静态合并：由 ThemeManager.Attach(this) 在构造期
                                注入**同一个可变字典实例**，主题切换时靠 DynamicResource 即时刷新
                                这里只合并控件样式（其内部一律用 DynamicResource 取色）
                        -->
                        <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="pack://application:,,,/LangCode.VsExt;component/Ui/Theme/Controls.xaml"/>
                        </ResourceDictionary.MergedDictionaries>

                        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                        <tw:EmptyToVisibilityConverter x:Key="EmptyToVis"/>
                        <tw:HexToBrushConverter x:Key="HexToBrush"/>

                        <!-- 卡片动作按钮上的文字（跟随按钮前景色） -->
                        <Style x:Key="ActLabel"
                               TargetType="TextBlock">
                                <Setter Property="FontFamily"
                                        Value="{DynamicResource Ap.FontUi}"/>
                                <Setter Property="FontSize"
                                        Value="11"/>
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Margin"
                                        Value="4,0,0,0"/>
                                <Setter Property="Foreground"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                        </Style>

                        <!-- 折叠箭头（IsChecked=True → 朝下展开；False → 朝右折叠） -->
                        <Style x:Key="ChevronToggle"
                               TargetType="ToggleButton">
                                <Setter Property="Width"
                                        Value="20"/>
                                <Setter Property="Height"
                                        Value="20"/>
                                <Setter Property="Cursor"
                                        Value="Hand"/>
                                <Setter Property="Template">
                                        <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                CornerRadius="4">
                                                                <Grid>
                                                                        <prim:Icon x:Name="ChevDown"
                                                                                   IconName="chevron-down"
                                                                                   Width="12"
                                                                                   Height="12"
                                                                                   Foreground="{DynamicResource Ap.IconDim}"/>
                                                                        <prim:Icon x:Name="ChevRight"
                                                                                   IconName="chevron-right"
                                                                                   Width="12"
                                                                                   Height="12"
                                                                                   Foreground="{DynamicResource Ap.IconDim}"
                                                                                   Visibility="Collapsed"/>
                                                                </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked"
                                                                         Value="True">
                                                                        <Setter TargetName="ChevDown"
                                                                                Property="Visibility"
                                                                                Value="Visible"/>
                                                                        <Setter TargetName="ChevRight"
                                                                                Property="Visibility"
                                                                                Value="Collapsed"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked"
                                                                         Value="False">
                                                                        <Setter TargetName="ChevDown"
                                                                                Property="Visibility"
                                                                                Value="Collapsed"/>
                                                                        <Setter TargetName="ChevRight"
                                                                                Property="Visibility"
                                                                                Value="Visible"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                                </Trigger>
                                                        </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                        </Setter.Value>
                                </Setter>
                        </Style>

                        <!-- 代码块底部的「展开全部 / 收起」条 -->
                        <Style x:Key="CodeToggleBar"
                               TargetType="ToggleButton">
                                <Setter Property="Height"
                                        Value="26"/>
                                <Setter Property="Cursor"
                                        Value="Hand"/>
                                <Setter Property="Template">
                                        <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Bd"
                                                                Background="{DynamicResource Ap.FooterBg}"
                                                                BorderBrush="{DynamicResource Ap.DividerSoft}"
                                                                BorderThickness="0,1,0,0"
                                                                CornerRadius="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                        <prim:Icon x:Name="ChevDown"
                                                                                   IconName="chevron-down"
                                                                                   Width="11"
                                                                                   Height="11"
                                                                                   Foreground="{DynamicResource Ap.IconDim}"
                                                                                   VerticalAlignment="Center"/>
                                                                        <prim:Icon x:Name="ChevUp"
                                                                                   IconName="chevron-down"
                                                                                   Width="11"
                                                                                   Height="11"
                                                                                   Foreground="{DynamicResource Ap.IconDim}"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="Collapsed"
                                                                                   RenderTransformOrigin="0.5,0.5">
                                                                                <prim:Icon.RenderTransform>
                                                                                        <RotateTransform Angle="180"/>
                                                                                </prim:Icon.RenderTransform>
                                                                        </prim:Icon>
                                                                        <TextBlock x:Name="LblExpand"
                                                                                   Text="展开全部"
                                                                                   Margin="5,0,0,0"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource Ap.IconDim}"
                                                                                   VerticalAlignment="Center"/>
                                                                        <TextBlock x:Name="LblCollapse"
                                                                                   Text="收起"
                                                                                   Margin="5,0,0,0"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource Ap.IconDim}"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="Collapsed"/>
                                                                        <TextBlock Text="{Binding LineCount, StringFormat=· {0} 行}"
                                                                                   Margin="4,0,0,0"
                                                                                   FontFamily="{DynamicResource Ap.FontCode}"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource Ap.FgFaint}"
                                                                                   VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked"
                                                                         Value="True">
                                                                        <Setter TargetName="ChevDown"
                                                                                Property="Visibility"
                                                                                Value="Collapsed"/>
                                                                        <Setter TargetName="ChevUp"
                                                                                Property="Visibility"
                                                                                Value="Visible"/>
                                                                        <Setter TargetName="LblExpand"
                                                                                Property="Visibility"
                                                                                Value="Collapsed"/>
                                                                        <Setter TargetName="LblCollapse"
                                                                                Property="Visibility"
                                                                                Value="Visible"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource Ap.ToolHeadBg}"/>
                                                                </Trigger>
                                                        </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                        </Setter.Value>
                                </Setter>
                        </Style>

                        <!-- ==================== 消息模板 ==================== -->

                        <DataTemplate x:Key="UserMessageTemplate">
                                <Grid HorizontalAlignment="Right"
                                      Margin="0,0,0,18">
                                        <!--
                                                编辑态：**就地**编辑 ——内容不搬到下面的输入框，
                                                改完直接在这条消息原来的位置上「保存并重新发送」
                                        -->
                                        <Border Visibility="{Binding ShowsEditor, Converter={StaticResource BoolToVis}}"
                                                MinWidth="300"
                                                MaxWidth="420"
                                                Background="{DynamicResource Ap.BgInput}"
                                                BorderBrush="{DynamicResource Ap.Accent}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="9,8">
                                                <StackPanel>
                                                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 MinHeight="56"
                                                                 MaxHeight="220"
                                                                 Padding="7,5"
                                                                 VerticalScrollBarVisibility="Auto"/>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,7,0,0">
                                                                <Button Style="{StaticResource ActButton}"
                                                                        Click="CancelEditMessage_Click">
                                                                        <TextBlock Text="取消"
                                                                                   Style="{StaticResource ActLabel}"/>
                                                                </Button>
                                                                <Button Style="{StaticResource ActPrimary}"
                                                                        Margin="6,0,0,0"
                                                                        Click="SaveEditMessage_Click"
                                                                        ToolTip="丢弃这条消息之后的对话，并用新内容重新发送">
                                                                        <StackPanel Orientation="Horizontal">
                                                                                <prim:Icon IconName="send-up"
                                                                                           Width="11"
                                                                                           Height="11"
                                                                                           VerticalAlignment="Center"/>
                                                                                <TextBlock Text="保存并重新发送"
                                                                                           Margin="5,0,0,0"
                                                                                           Style="{StaticResource ActLabel}"/>
                                                                        </StackPanel>
                                                                </Button>
                                                        </StackPanel>
                                                </StackPanel>
                                        </Border>

                                        <!-- 正常态：气泡本体（点它就地编辑）+ 排队提示 -->
                                        <StackPanel HorizontalAlignment="Right"
                                                    Visibility="{Binding ShowsBubble, Converter={StaticResource BoolToVis}}">
                                                <!--
                                                        点气泡就能改 ——不必先去找一支铅笔图标
                                                        自己写的提示词说错一个字很常见，没必要为此重建整个会话
                                                -->
                                                <Border MaxWidth="360"
                                                        HorizontalAlignment="Right"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="EditMessage_Click"
                                                        ToolTip="点击编辑这条消息并重新发送（会丢弃它之后的对话）"
                                                        Background="{DynamicResource Ap.BgCard}"
                                                        BorderBrush="{DynamicResource Ap.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="12,12,4,12"
                                                        Padding="12,9">
                                                        <StackPanel>
                                                                <TextBlock Text="{Binding Text}"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource Ap.FgBright}"
                                                                           FontSize="13"
                                                                           LineHeight="21"
                                                                           LineStackingStrategy="BlockLineHeight"/>
                                                                <!--
                                                                        气泡右下角的「编辑」提示（对齐设计稿）：
                                                                        气泡本身就是点击就地编辑的入口，这里把这件事说出来，不必靠 ToolTip 猜
                                                                -->
                                                                <TextBlock Text="编辑"
                                                                           HorizontalAlignment="Right"
                                                                           Margin="0,5,0,0"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource Ap.FgFaint}"/>
                                                        </StackPanel>
                                                </Border>
                                                <!-- 生成中排队的消息：明确标出来，别让人以为它已经发出去了 -->
                                                <TextBlock Text="排队中 · 当前任务结束后自动发送"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,2,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Ap.FgFaint}"
                                                           Visibility="{Binding IsQueued, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                </Grid>
                        </DataTemplate>

                        <!--
                                助手正文走 Markdown 渲染（标题 / 列表 / 引用 / 围栏代码 / 表格）
                                注意：这里**不能**套 TdBody 样式 —— 它的 TargetType 是 TextBlock，
                                套到 MarkdownView 上会在运行时抛「样式目标类型不匹配」
                                字体与配色由 MarkdownView 内部按主题解析
                        -->
                        <DataTemplate x:Key="TextBlockTemplate">
                                <!-- 头像与步骤标签由外层 AssistantMessageTemplate 统一绘制（每一步一个）；这里只负责正文 -->
                                <ui:MarkdownView Markdown="{Binding Text}"
                                                 BaseFontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                 Margin="0,9,0,0"/>
                        </DataTemplate>

                        <DataTemplate x:Key="ThinkingBlockTemplate">
                                <!-- 头像与步骤标签由外层 AssistantMessageTemplate 统一绘制（每一步一个） -->
                                <Border Margin="0,6,0,0"
                                        Background="{DynamicResource Ap.BgCard}"
                                        BorderBrush="{DynamicResource Ap.ToolBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel>
                                                <Border Background="Transparent"
                                                        Padding="8,8,11,8">
                                                        <!-- 整行都可点：箭头只当指示器（命中交给整行），避免一次点击被处理两遍 -->
                                                        <Grid Cursor="Hand"
                                                              Background="Transparent"
                                                              MouseLeftButtonUp="ThinkingHeader_Click"
                                                              ToolTip="点击展开 / 收起这一步的思考">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <ToggleButton Grid.Column="0"
                                                                              Style="{StaticResource ChevronToggle}"
                                                                              IsChecked="{Binding IsBodyVisible}"
                                                                              IsHitTestVisible="False"
                                                                              VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding ThinkingLabel}"
                                                                           Margin="4,0,0,0"
                                                                           FontSize="11.5"
                                                                           Foreground="{DynamicResource Ap.FgDim}"
                                                                           VerticalAlignment="Center"/>
                                                        </Grid>
                                                </Border>

                                                <Border BorderBrush="{DynamicResource Ap.ToolBorder}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="11,8,11,9"
                                                        Visibility="{Binding IsBodyVisible, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Text}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource Ap.FgDim}"
                                                                   FontStyle="Italic"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="19"
                                                                   LineStackingStrategy="BlockLineHeight"/>
                                                </Border>
                                        </StackPanel>
                                </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="DiffLineTemplate">
                                <Border x:Name="Row"
                                        Padding="6,0,11,0">
                                        <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Sign"
                                                           Text="{Binding Sign}"
                                                           FontFamily="{DynamicResource Ap.FontCode}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Ap.DiffSignFg}"/>
                                                <TextBlock x:Name="Code"
                                                           Text="{Binding Text}"
                                                           FontFamily="{DynamicResource Ap.FontCode}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Ap.DiffCtxFg}"
                                                           TextWrapping="NoWrap"/>
                                        </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}"
                                                     Value="{x:Static models:DiffLineKind.Add}">
                                                <Setter TargetName="Row"
                                                        Property="Background"
                                                        Value="{DynamicResource Ap.DiffAddBg}"/>
                                                <Setter TargetName="Code"
                                                        Property="Foreground"
                                                        Value="{DynamicResource Ap.DiffAddFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}"
                                                     Value="{x:Static models:DiffLineKind.Delete}">
                                                <Setter TargetName="Row"
                                                        Property="Background"
                                                        Value="{DynamicResource Ap.DiffDelBg}"/>
                                                <Setter TargetName="Code"
                                                        Property="Foreground"
                                                        Value="{DynamicResource Ap.DiffDelFg}"/>
                                                <!-- 删除行加删除线（对齐设计稿：删除=灰字 + 删除线 + − 号点红） -->
                                                <Setter TargetName="Code"
                                                        Property="TextDecorations"
                                                        Value="Strikethrough"/>
                                        </DataTrigger>
                                </DataTemplate.Triggers>
                        </DataTemplate>

                        <DataTemplate x:Key="CodeCardTemplate">
                                <Border x:Name="Card"
                                        Margin="{Binding CardMargin}"
                                        Background="{DynamicResource Ap.BgCard}"
                                        BorderBrush="{DynamicResource Ap.ToolBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel>
                                                <!-- 扁平头部：不铺底色，只留一条分隔线（对齐设计稿的卡片观感） -->
                                                <Border Background="Transparent"
                                                        BorderBrush="{DynamicResource Ap.ToolBorder}"
                                                        BorderThickness="0,0,0,1"
                                                        CornerRadius="0"
                                                        Padding="9,9,11,9">
                                                        <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <prim:Icon Grid.Column="0"
                                                                           IconName="file"
                                                                           Width="13"
                                                                           Height="13"
                                                                           Foreground="{DynamicResource Ap.FgFaint}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Title}"
                                                                           Margin="6,0,0,0"
                                                                           FontSize="12"
                                                                           FontWeight="Medium"
                                                                           Foreground="{DynamicResource Ap.FgStrong}"
                                                                           VerticalAlignment="Center"/>
                                                                <!-- 点击路径直接在 VS 里打开（有行号就跳过去） -->
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding Path}"
                                                                           Margin="6,0,0,0"
                                                                           Style="{StaticResource TdMono}"
                                                                           Foreground="#FF8B8B8B"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Cursor="Hand"
                                                                           ToolTip="点击在 Visual Studio 中打开"
                                                                           MouseLeftButtonUp="Path_Click"
                                                                           VerticalAlignment="Center"/>
                                                                <ToggleButton Grid.Column="3"
                                                                              Style="{StaticResource ChevronToggle}"
                                                                              IsChecked="{Binding IsBodyVisible}"/>
                                                        </Grid>
                                                </Border>

                                                <StackPanel Visibility="{Binding IsBodyVisible, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                                <Border x:Name="CodeWrap"
                                                                        MaxHeight="176"
                                                                        ClipToBounds="True"
                                                                        Background="{DynamicResource Ap.BgCard}">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   Margin="11,9,11,9"
                                                                                   FontFamily="{DynamicResource Ap.FontCode}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="{DynamicResource Ap.CodeFg}"
                                                                                   LineHeight="19"
                                                                                   TextWrapping="NoWrap"/>
                                                                </Border>
                                                                <Border x:Name="CodeFade"
                                                                        Height="62"
                                                                        VerticalAlignment="Bottom"
                                                                        IsHitTestVisible="False">
                                                                        <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                                     EndPoint="0,1">
                                                                                        <GradientStop Offset="0"
                                                                                                      Color="#001E2126"/>
                                                                                        <GradientStop Offset="0.92"
                                                                                                      Color="#FF1E2126"/>
                                                                                </LinearGradientBrush>
                                                                        </Border.Background>
                                                                </Border>
                                                        </Grid>
                                                        <ToggleButton Style="{StaticResource CodeToggleBar}"
                                                                      IsChecked="{Binding IsExpanded}"/>
                                                </StackPanel>

                                                <!--
                                                        底栏只留状态文案（已应用 / 已拒绝 / 已撤销）
                                                        「允许 / 拒绝」统一搬到输入框上方的请求条：待批的卡片可能在滚动区外，
                                                        按钮跟着卡片跑反而点不到；而且一次只可能有一个动作在等拍板
                                                -->
                                                <Border Background="{DynamicResource Ap.FooterBg}"
                                                        BorderBrush="{DynamicResource Ap.DividerSoft}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="8,6"
                                                        Visibility="{Binding ShowsFooter, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                                <TextBlock Text="等待你在输入框上方确认"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Ap.Accent}"
                                                                           Visibility="{Binding IsPendingApproval, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock x:Name="Status"
                                                                           Text="{Binding StatusText}"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="11"
                                                                           FontFamily="{DynamicResource Ap.FontCode}"
                                                                           Foreground="{DynamicResource Ap.Teal}"
                                                                           Visibility="{Binding StatusText, Converter={StaticResource EmptyToVis}}"/>
                                                        </Grid>
                                                </Border>
                                        </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}"
                                                     Value="True">
                                                <Setter TargetName="CodeWrap"
                                                        Property="MaxHeight"
                                                        Value="4000"/>
                                                <Setter TargetName="CodeFade"
                                                        Property="Visibility"
                                                        Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAccepted}"
                                                     Value="True">
                                                <Setter TargetName="Card"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource Ap.TealBorderSoft}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRejected}"
                                                     Value="True">
                                                <Setter TargetName="Card"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource Ap.RedBorderSoft}"/>
                                                <Setter TargetName="Card"
                                                        Property="Opacity"
                                                        Value="0.48"/>
                                                <Setter TargetName="Status"
                                                        Property="Foreground"
                                                        Value="{DynamicResource Ap.Red}"/>
                                        </DataTrigger>
                                </DataTemplate.Triggers>
                        </DataTemplate>

                        <DataTemplate x:Key="DiffCardTemplate">
                                <Border x:Name="Card"
                                        Margin="{Binding CardMargin}"
                                        Background="{DynamicResource Ap.BgCard}"
                                        BorderBrush="{DynamicResource Ap.ToolBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel>
                                                <!-- 扁平头部：与代码卡一致，不铺底色 -->
                                                <Border Background="Transparent"
                                                        BorderBrush="{DynamicResource Ap.ToolBorder}"
                                                        BorderThickness="0,0,0,1"
                                                        CornerRadius="0"
                                                        Padding="9,9,11,9">
                                                        <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <prim:Icon Grid.Column="0"
                                                                           IconName="edit"
                                                                           Width="13"
                                                                           Height="13"
                                                                           Foreground="{DynamicResource Ap.FgFaint}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Title}"
                                                                           Margin="6,0,0,0"
                                                                           FontSize="12"
                                                                           FontWeight="Medium"
                                                                           Foreground="{DynamicResource Ap.FgStrong}"
                                                                           VerticalAlignment="Center"/>
                                                                <!-- 点击路径直接在 VS 里打开（有行号就跳过去） -->
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding Path}"
                                                                           Margin="6,0,0,0"
                                                                           Style="{StaticResource TdMono}"
                                                                           Foreground="#FF8B8B8B"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Cursor="Hand"
                                                                           ToolTip="点击在 Visual Studio 中打开"
                                                                           MouseLeftButtonUp="Path_Click"
                                                                           VerticalAlignment="Center"/>
                                                                <!-- 只有真正的差异卡才显示 +N/−N；操作确认卡（审批）复用本模板但不显示统计 -->
                                                                <StackPanel Grid.Column="3"
                                                                            Orientation="Horizontal"
                                                                            Margin="0,0,6,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding ShowsDiffStats, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{Binding AddLabel}"
                                                                                   Foreground="{DynamicResource Ap.Teal}"
                                                                                   FontFamily="{DynamicResource Ap.FontCode}"
                                                                                   FontSize="11"/>
                                                                        <TextBlock Text="{Binding DeleteLabel}"
                                                                                   Margin="6,0,0,0"
                                                                                   Foreground="{DynamicResource Ap.Red}"
                                                                                   FontFamily="{DynamicResource Ap.FontCode}"
                                                                                   FontSize="11"/>
                                                                </StackPanel>
                                                                <ToggleButton Grid.Column="4"
                                                                              Style="{StaticResource ChevronToggle}"
                                                                              IsChecked="{Binding IsBodyVisible}"/>
                                                        </Grid>
                                                </Border>

                                                <StackPanel Visibility="{Binding IsBodyVisible, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl ItemsSource="{Binding Lines}"
                                                                      ItemTemplate="{StaticResource DiffLineTemplate}"
                                                                      Margin="0,2,0,2"/>

                                                        <Border Background="{DynamicResource Ap.FooterBg}"
                                                                BorderBrush="{DynamicResource Ap.DividerSoft}"
                                                                BorderThickness="0,1,0,0"
                                                                Padding="8,6"
                                                                Visibility="{Binding ShowsFooter, Converter={StaticResource BoolToVis}}">
                                                                <Grid>
                                                                        <TextBlock Text="等待你在输入框上方确认"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource Ap.Accent}"
                                                                                   Visibility="{Binding IsPendingApproval, Converter={StaticResource BoolToVis}}"/>
                                                                        <TextBlock x:Name="Status"
                                                                                   Text="{Binding StatusText}"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="11"
                                                                                   FontFamily="{DynamicResource Ap.FontCode}"
                                                                                   Foreground="{DynamicResource Ap.Teal}"
                                                                                   Visibility="{Binding StatusText, Converter={StaticResource EmptyToVis}}"/>
                                                                </Grid>
                                                        </Border>
                                                </StackPanel>
                                        </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAccepted}"
                                                     Value="True">
                                                <Setter TargetName="Card"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource Ap.TealBorderSoft}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRejected}"
                                                     Value="True">
                                                <Setter TargetName="Card"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource Ap.RedBorderSoft}"/>
                                                <Setter TargetName="Card"
                                                        Property="Opacity"
                                                        Value="0.48"/>
                                                <Setter TargetName="Status"
                                                        Property="Foreground"
                                                        Value="{DynamicResource Ap.Red}"/>
                                        </DataTrigger>
                                </DataTemplate.Triggers>
                        </DataTemplate>

                        <DataTemplate x:Key="NoteBlockTemplate">
                                <!-- 批注：左侧一条主色细轨（对齐设计稿），不做整框 -->
                                <Border Margin="{Binding NoteMargin}"
                                        Background="{DynamicResource Ap.AccentSoftWeak}"
                                        BorderBrush="{DynamicResource Ap.NoteBorder}"
                                        BorderThickness="2,0,0,0"
                                        CornerRadius="0,6,6,0"
                                        Padding="10,3,8,3">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <prim:Icon Grid.Column="0"
                                                           IconName="comment"
                                                           Width="12"
                                                           Height="12"
                                                           Foreground="{DynamicResource Ap.Accent}"
                                                           VerticalAlignment="Top"
                                                           Margin="0,1,7,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Ap.NoteFg}"
                                                           LineHeight="18"
                                                           LineStackingStrategy="BlockLineHeight"/>
                                        </Grid>
                                </Border>
                        </DataTemplate>

                        <DataTemplate x:Key="DoneBlockTemplate">
                                <!--
                                        完成提示：**虚线细条**（对齐设计稿）
                                        Border 画不出虚线，改用 Rectangle + StrokeDashArray，内容叠在它上面
                                -->
                                <Grid Margin="0,9,0,0">
                                        <Rectangle RadiusX="9"
                                                   RadiusY="9"
                                                   Fill="{DynamicResource Ap.DoneBg}"
                                                   Stroke="{DynamicResource Ap.DoneBorder}"
                                                   StrokeThickness="1"
                                                   StrokeDashArray="3 3"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="11,8">
                                                <prim:Icon IconName="check"
                                                           Width="14"
                                                           Height="14"
                                                           Foreground="{DynamicResource Ap.Accent}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Text}"
                                                           Margin="7,0,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Ap.DoneFg}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                        </StackPanel>
                                </Grid>
                        </DataTemplate>

                        <!-- ══════════════════ 长任务编排：任务进度卡 ══════════════════ -->
                        <DataTemplate x:Key="TodoBlockTemplate">
                                <!-- 任务清单卡：与其它卡片同一张中性卡（进度符号由主色承担） -->
                                <Border Margin="{Binding NoteMargin}"
                                        Background="{DynamicResource Ap.BgCard}"
                                        BorderBrush="{DynamicResource Ap.ToolBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="11,9">
                                        <StackPanel>
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <prim:Icon Grid.Column="0"
                                                                   IconName="check"
                                                                   Width="13"
                                                                   Height="13"
                                                                   Foreground="{DynamicResource Ap.Accent}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Title}"
                                                                   Margin="7,0,0,0"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Ap.NoteFg}"
                                                                   VerticalAlignment="Center"/>
                                                </Grid>

                                                <TextBlock Text="{Binding ProgressText}"
                                                           Margin="0,6,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Ap.FgFaint}"/>

                                                <ItemsControl ItemsSource="{Binding Todos}"
                                                              Margin="0,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Grid Margin="0,2,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Grid Grid.Column="0"
                                                                                      Width="14">
                                                                                        <!-- 已完成 / 待办：静态符号（✓ / ○） -->
                                                                                        <TextBlock Text="{Binding Marker}"
                                                                                                   FontSize="11.5"
                                                                                                   Foreground="{DynamicResource Ap.Accent}"
                                                                                                   VerticalAlignment="Top">
                                                                                                <TextBlock.Style>
                                                                                                        <Style TargetType="TextBlock">
                                                                                                                <Style.Triggers>
                                                                                                                        <DataTrigger Binding="{Binding IsInProgress}"
                                                                                                                                     Value="True">
                                                                                                                                <Setter Property="Visibility"
                                                                                                                                        Value="Collapsed"/>
                                                                                                                        </DataTrigger>
                                                                                                                </Style.Triggers>
                                                                                                        </Style>
                                                                                                </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <!--
                                                                                                                                进行中：转圈动画
                                                                                                                                静态符号在长任务里分不清「正在跑」还是「卡住了」，
                                                                                                                                转动本身就能传达「它还在动」
                                                                                        -->
                                                                                        <prim:Icon IconName="spinner"
                                                                                                   Width="11"
                                                                                                   Height="11"
                                                                                                   Margin="1,3,0,0"
                                                                                                   HorizontalAlignment="Left"
                                                                                                   VerticalAlignment="Top"
                                                                                                   Foreground="{DynamicResource Ap.Accent}"
                                                                                                   RenderTransformOrigin="0.5,0.5">
                                                                                                <prim:Icon.RenderTransform>
                                                                                                        <RotateTransform/>
                                                                                                </prim:Icon.RenderTransform>
                                                                                                <prim:Icon.Style>
                                                                                                        <Style TargetType="prim:Icon">
                                                                                                                <Setter Property="Visibility"
                                                                                                                        Value="Collapsed"/>
                                                                                                                <Style.Triggers>
                                                                                                                        <DataTrigger Binding="{Binding IsInProgress}"
                                                                                                                                     Value="True">
                                                                                                                                <Setter Property="Visibility"
                                                                                                                                        Value="Visible"/>
                                                                                                                        </DataTrigger>
                                                                                                                </Style.Triggers>
                                                                                                        </Style>
                                                                                                </prim:Icon.Style>
                                                                                                <prim:Icon.Triggers>
                                                                                                        <EventTrigger RoutedEvent="Loaded">
                                                                                                                <BeginStoryboard Storyboard="{StaticResource Ap.Spin}"/>
                                                                                                        </EventTrigger>
                                                                                                </prim:Icon.Triggers>
                                                                                        </prim:Icon>
                                                                                </Grid>
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding Text}"
                                                                                           TextWrapping="Wrap"
                                                                                           FontSize="11.5"
                                                                                           LineHeight="17"
                                                                                           LineStackingStrategy="BlockLineHeight">
                                                                                        <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                        <Setter Property="Foreground"
                                                                                                                Value="{DynamicResource Ap.NoteFg}"/>
                                                                                                        <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding IsCompleted}"
                                                                                                                             Value="True">
                                                                                                                        <Setter Property="TextDecorations"
                                                                                                                                Value="Strikethrough"/>
                                                                                                                        <Setter Property="Foreground"
                                                                                                                                Value="{DynamicResource Ap.FgFaint}"/>
                                                                                                                </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                </Style>
                                                                                        </TextBlock.Style>
                                                                                </TextBlock>
                                                                        </Grid>
                                                                </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                        </StackPanel>
                                </Border>
                        </DataTemplate>

                        <!-- ══════════════════ 长任务编排：提问卡（对齐 UIUX 模板 .ask） ══════════════════ -->
                        <DataTemplate x:Key="QuestionBlockTemplate">
                                <Border Margin="{Binding NoteMargin}"
                                        Background="{DynamicResource Ap.BgCard}"
                                        BorderBrush="{DynamicResource Ap.ToolBorder}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <StackPanel>
                                                <!-- 问题：与下方选项之间一条分隔线（.ask .q） -->
                                                <Border Padding="11,9,11,8"
                                                        BorderBrush="{DynamicResource Ap.DividerSoft}"
                                                        BorderThickness="0,0,0,1">
                                                        <StackPanel Orientation="Horizontal">
                                                                <prim:Icon IconName="comment"
                                                                           Width="13"
                                                                           Height="13"
                                                                           Margin="0,1,0,0"
                                                                           Foreground="{DynamicResource Ap.FgFaint}"
                                                                           VerticalAlignment="Top"/>
                                                                <TextBlock Text="{Binding Text}"
                                                                           Margin="8,0,0,0"
                                                                           TextWrapping="Wrap"
                                                                           FontSize="12.5"
                                                                           Foreground="{DynamicResource Ap.FgStrong}"
                                                                           LineHeight="19"
                                                                           LineStackingStrategy="BlockLineHeight"/>
                                                        </StackPanel>
                                                </Border>

                                                <!--
                                                        备选答案：**一行一个、纵向铺满**（选项文字往往较长，横排换行会打断阅读）
                                                        点一下就是一次回答；要自由回答就在底部输入框打字回车
                                                -->
                                                <ItemsControl ItemsSource="{Binding Options}"
                                                              Margin="8,7,8,3"
                                                              Visibility="{Binding ShowsOptions, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Button Style="{StaticResource OptionButton}"
                                                                                Tag="{Binding}"
                                                                                Click="QuestionOption_Click"
                                                                                Content="{Binding}"/>
                                                                </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- 已作答：✓ + 回答（.ask .picked）；「跳过」不给那枚 ✓ -->
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="11,9,11,9"
                                                            Visibility="{Binding IsAnswered, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="✓"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource Ap.Teal}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding ShowsAnswerCheck, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding AnswerText}"
                                                                   Margin="7,0,0,0"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource Ap.TealText}"
                                                                   VerticalAlignment="Center"/>
                                                </StackPanel>
                                        </StackPanel>
                                </Border>
                        </DataTemplate>

                        <!-- ══════════════════ 长任务编排：子任务卡 ══════════════════ -->
                        <DataTemplate x:Key="SubTaskBlockTemplate">
                                <Border Margin="{Binding NoteMargin}"
                                        Background="{DynamicResource Ap.BgCard}"
                                        BorderBrush="{DynamicResource Ap.ToolBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="11,9">
                                        <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                        <!-- 「子任务」胶囊徽标：一眼看出这是派生出去的独立任务 -->
                                                        <Border Background="{DynamicResource Ap.AccentSoft}"
                                                                BorderBrush="{DynamicResource Ap.AccentBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="99"
                                                                Padding="8,1">
                                                                <TextBlock Text="子任务"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource Ap.Accent}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Margin="8,0,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Ap.FgFaint}"
                                                                   VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Text}"
                                                           Margin="0,6,0,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Ap.NoteFg}"
                                                           LineHeight="17"
                                                           LineStackingStrategy="BlockLineHeight"/>
                                        </StackPanel>
                                </Border>
                        </DataTemplate>

                        <tw:ChatBlockTemplateSelector x:Key="BlockSelector"
                                                      TextTemplate="{StaticResource TextBlockTemplate}"
                                                      ThinkingTemplate="{StaticResource ThinkingBlockTemplate}"
                                                      CodeTemplate="{StaticResource CodeCardTemplate}"
                                                      DiffTemplate="{StaticResource DiffCardTemplate}"
                                                      DoneTemplate="{StaticResource DoneBlockTemplate}"
                                                      TodoTemplate="{StaticResource TodoBlockTemplate}"
                                                      QuestionTemplate="{StaticResource QuestionBlockTemplate}"
                                                      SubTaskTemplate="{StaticResource SubTaskBlockTemplate}"/>

                        <DataTemplate x:Key="AssistantMessageTemplate">
                                <Grid Margin="0,0,0,18">
                                        <!--
                                                头像不再挂「一条消息」上：改成**每一步**一个，
                                                由思考行与正文各自的模板画出来（多步任务才看得出步骤推进）
                                        -->
                                        <StackPanel>
                                                <ItemsControl ItemsSource="{Binding Blocks}">
                                                        <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!--
                                                                                        每一步一个头像（**所有**助手块都有：读文件 / 修改 / 提问 / 完成…），
                                                                                        用户气泡不在此列 —— 它由 UserMessageTemplate 单独渲染，不带头像
                                                                                -->
                                                                                <Border Grid.Column="0"
                                                                                        Width="20"
                                                                                        Height="20"
                                                                                        CornerRadius="5"
                                                                                        Background="{DynamicResource Ap.AvatarBg}"
                                                                                        VerticalAlignment="Top"
                                                                                        Margin="0,1,0,0">
                                                                                        <prim:Icon IconName="code"
                                                                                                   Width="12"
                                                                                                   Height="12"
                                                                                                   Foreground="{DynamicResource Ap.AvatarFg}"/>
                                                                                </Border>

                                                                                <StackPanel Grid.Column="1"
                                                                                            Margin="8,0,0,0">
                                                                                        <ContentPresenter Content="{Binding}"
                                                                                                          ContentTemplateSelector="{StaticResource BlockSelector}"/>
                                                                                </StackPanel>
                                                                        </Grid>
                                                                </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!--
                                                        继续任务 / 重试 / 撤销修改 **不再固定挂在消息下面**：
                                                        它们按需出现在输入框上方的请求条上（判定逻辑见 Models/RequestBar.cs），
                                                        任务正常跑完时什么按钮都不显示
                                                -->
                                        </StackPanel>
                                </Grid>
                        </DataTemplate>

                        <!--
                                分段控件（计划 / 执行）：两个按钮共用一圈边框、中间只隔一条线，
                                一眼能看出「它们是同一组的两种状态」，而不是两个互不相干的开关
                        -->
                        <Style x:Key="SegmentLeft"
                               TargetType="ToggleButton">
                                <Setter Property="Cursor"
                                        Value="Hand"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Ap.FgMenu}"/>
                                <Setter Property="Template">
                                        <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                CornerRadius="5,0,0,5"
                                                                Padding="9,4">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked"
                                                                         Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource Ap.AccentSoftWeak}"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource Ap.Accent}"/>
                                                                </Trigger>
                                                        </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                        </Setter.Value>
                                </Setter>
                        </Style>

                        <Style x:Key="SegmentRight"
                               TargetType="ToggleButton">
                                <Setter Property="Cursor"
                                        Value="Hand"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Ap.FgMenu}"/>
                                <Setter Property="Template">
                                        <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                CornerRadius="0,5,5,0"
                                                                Padding="9,4">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked"
                                                                         Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource Ap.AccentSoftWeak}"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource Ap.Accent}"/>
                                                                </Trigger>
                                                        </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                        </Setter.Value>
                                </Setter>
                        </Style>

                        <tw:ChatMessageTemplateSelector x:Key="MessageSelector"
                                                        UserTemplate="{StaticResource UserMessageTemplate}"
                                                        AssistantTemplate="{StaticResource AssistantMessageTemplate}"/>
                </ResourceDictionary>
        </UserControl.Resources>

        <Grid Background="{DynamicResource Ap.Bg}">
                <Grid>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ══════════════════ HEADER ══════════════════ -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource Ap.BgElevated}"
                                BorderBrush="{DynamicResource Ap.BorderSoft}"
                                BorderThickness="0,0,0,1">
                                <Grid Margin="12,0,6,0">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <prim:Icon IconName="code"
                                                           Width="17"
                                                           Height="17"
                                                           Foreground="{DynamicResource Ap.FgBright}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="LangCode"
                                                           Style="{StaticResource TdBrand}"
                                                           Margin="7,0,0,0"
                                                           VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                <!-- 新建会话：立刻开一个空会话（旧会话已经落盘，可随时从历史里找回来） -->
                                                <Button x:Name="BtnNewChat"
                                                        Style="{StaticResource IconButton}"
                                                        AutomationProperties.Name="新建会话"
                                                        ToolTip="新建会话"
                                                        Click="BtnNewChat_Click">
                                                        <prim:Icon IconName="plus"
                                                                   Width="15"
                                                                   Height="15"/>
                                                </Button>
                                                <Button x:Name="BtnHistory"
                                                        Style="{StaticResource IconButton}"
                                                        AutomationProperties.Name="历史记录"
                                                        ToolTip="历史记录"
                                                        Click="BtnHistory_Click">
                                                        <prim:Icon IconName="history"
                                                                   Width="15"
                                                                   Height="15"/>
                                                </Button>
                                                <!-- MCP 服务器的入口已收进「设置 → MCP」：顶部只留最常用的三个 -->
                                                <Button x:Name="BtnSettings"
                                                        Style="{StaticResource IconButton}"
                                                        AutomationProperties.Name="设置"
                                                        ToolTip="设置"
                                                        Click="BtnSettings_Click">
                                                        <prim:Icon IconName="settings"
                                                                   Width="15"
                                                                   Height="15"/>
                                                </Button>
                                        </StackPanel>
                                </Grid>
                        </Border>

                        <!-- ══════════════════ 会话头 + 上下文 ══════════════════ -->
                        <!-- 主页（空会话）时整条收起：那时没有上下文可算，摆着只会分散注意力 -->
                        <Border x:Name="TokenBar"
                                Grid.Row="1"
                                Background="{DynamicResource Ap.BgElevated}"
                                BorderBrush="{DynamicResource Ap.DividerSoft}"
                                BorderThickness="0,0,0,1"
                                Padding="12,10,12,0">
                                <StackPanel>
                                        <!-- 会话头：live dot + 会话标题（标题取首条用户消息，见 UpdateSessionHeader） -->
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,9">
                                                <Ellipse x:Name="LiveDot"
                                                         Width="6"
                                                         Height="6"
                                                         Fill="{DynamicResource Ap.Teal}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SessionTitle"
                                                           Text="新会话"
                                                           Margin="7,0,0,0"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ap.FgBright}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!--
                                                上下文：概览行常驻（上下文用量），点整行展开明细
                                                与「任务清单」进度条同一套样式（渐变条 + 等宽数值）
                                        -->
                                        <ToggleButton x:Name="ContextToggle"
                                                      Style="{StaticResource SectionHeaderToggle}"
                                                      Click="StatusHeader_Click"
                                                      ToolTip="点击展开 / 收起上下文明细">
                                                <Grid Cursor="Hand">
                                                        <!-- hover 变浅底（对齐设计稿）：整行可点，得让人看得出可点 -->
                                                        <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                        <Setter Property="Background"
                                                                                Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver"
                                                                                         Value="True">
                                                                                        <Setter Property="Background"
                                                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                                                </Trigger>
                                                                        </Style.Triggers>
                                                                </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <prim:Icon Grid.Column="0"
                                                                   IconName="zap"
                                                                   Width="12"
                                                                   Height="12"
                                                                   Foreground="{DynamicResource Ap.IconFaint}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="上下文"
                                                                   Margin="7,0,0,0"
                                                                   Style="{StaticResource TdCaption}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   x:Name="TkNum"
                                                                   Text="0 / 200k"
                                                                   Margin="8,0,0,0"
                                                                   Style="{StaticResource TdMono}"
                                                                   VerticalAlignment="Center"/>
                                                        <Grid Grid.Column="3"
                                                              Width="70"
                                                              Height="4"
                                                              Margin="8,0,0,0"
                                                              VerticalAlignment="Center"
                                                              ToolTip="上下文占用：输入 / 输出 / 剩余">
                                                                <Border Background="{DynamicResource Ap.TrackBg}"
                                                                        CornerRadius="2"/>
                                                                <Grid ClipToBounds="True">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition x:Name="TkInCol"
                                                                                                  Width="0*"/>
                                                                                <ColumnDefinition x:Name="TkOutCol"
                                                                                                  Width="0*"/>
                                                                                <ColumnDefinition x:Name="TkRestCol"
                                                                                                  Width="1*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0"
                                                                                Background="{DynamicResource Ap.BarGrad}"/>
                                                                        <Border Grid.Column="1"
                                                                                Background="{DynamicResource Ap.BarGrad}"/>
                                                                </Grid>
                                                        </Grid>
                                                        <!-- 百分比与数值同为等宽正文，不做色块（对齐设计稿的克制用色） -->
                                                        <TextBlock Grid.Column="4"
                                                                   x:Name="TkPct"
                                                                   Text="0.0%"
                                                                   Margin="8,0,0,0"
                                                                   Style="{StaticResource TdMono}"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- 费用：与上下文合并到同一条（右对齐，等宽） -->
                                                        <TextBlock Grid.Column="7"
                                                                   x:Name="TkCost"
                                                                   Text="≈ $0.0000"
                                                                   Margin="10,0,0,0"
                                                                   Style="{StaticResource TdMono}"
                                                                   Foreground="{DynamicResource Ap.TealText}"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="按模型单价估算的费用（整个会话），不是账单金额"/>
                                                        <prim:Icon x:Name="StatusChevron"
                                                                   Grid.Column="8"
                                                                   IconName="chevron-right"
                                                                   Width="11"
                                                                   Height="11"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource Ap.IconDim}"
                                                                   VerticalAlignment="Center"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                                <prim:Icon.RenderTransform>
                                                                        <RotateTransform Angle="0"/>
                                                                </prim:Icon.RenderTransform>
                                                        </prim:Icon>
                                                </Grid>
                                        </ToggleButton>

                                        <!-- 明细区：默认折叠，点上方概览行展开（用量拆分） -->
                                        <StackPanel x:Name="StatusDetail"
                                                    Visibility="{Binding IsChecked, ElementName=ContextToggle, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Margin="0,8,0,0">
                                                        <!-- 用量明细：左标签 / 右数值（等宽），与设计稿一致 -->
                                                        <Grid Margin="0,0,0,5">
                                                                <TextBlock Text="输入 token"
                                                                           Style="{StaticResource TdCaption}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="TkInTxt"
                                                                           Text="0"
                                                                           HorizontalAlignment="Right"
                                                                           Style="{StaticResource TdMono}"
                                                                           VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Grid Margin="0,0,0,5">
                                                                <TextBlock Text="输出 token"
                                                                           Style="{StaticResource TdCaption}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="TkOutTxt"
                                                                           Text="0"
                                                                           HorizontalAlignment="Right"
                                                                           Style="{StaticResource TdMono}"
                                                                           VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Grid Margin="0,0,0,5">
                                                                <TextBlock Text="剩余可用"
                                                                           Style="{StaticResource TdCaption}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="TkFree"
                                                                           Text="200k"
                                                                           HorizontalAlignment="Right"
                                                                           Style="{StaticResource TdMono}"
                                                                           VerticalAlignment="Center"/>
                                                        </Grid>
                                                </StackPanel>

                                                <!-- 会话操作：复制提示词 / 压缩上下文 / 删除会话 -->
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,10,0,0">
                                                        <Button x:Name="CopyPromptBtn"
                                                                Style="{StaticResource IconButton}"
                                                                Width="26"
                                                                Height="26"
                                                                Click="CopyPrompt_Click"
                                                                ToolTip="复制首条提示词">
                                                                <prim:Icon IconName="file"
                                                                           Width="14"
                                                                           Height="14"/>
                                                        </Button>
                                                        <Button x:Name="CompactContextBtn"
                                                                Style="{StaticResource IconButton}"
                                                                Width="26"
                                                                Height="26"
                                                                Margin="6,0,0,0"
                                                                Click="CompactContext_Click"
                                                                ToolTip="压缩上下文（折叠较早的中间对话）">
                                                                <prim:Icon IconName="sliders"
                                                                           Width="14"
                                                                           Height="14"/>
                                                        </Button>
                                                        <Button x:Name="DeleteSessionBtn"
                                                                Style="{StaticResource IconButton}"
                                                                Width="26"
                                                                Height="26"
                                                                Margin="6,0,0,0"
                                                                Click="DeleteSession_Click"
                                                                ToolTip="删除当前会话">
                                                                <prim:Icon IconName="trash"
                                                                           Width="14"
                                                                           Height="14"/>
                                                        </Button>
                                                        <TextBlock x:Name="SessionActionHint"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="10.5"
                                                                   Visibility="Collapsed"
                                                                   Foreground="{DynamicResource Ap.FgFaint}"/>
                                                </StackPanel>
                                        </StackPanel>
                                </StackPanel>
                        </Border>

                        <!-- ══════════════════ 任务清单 ══════════════════ -->
                        <!-- 独立成条（默认折叠）：进度条常驻在头部，明细点开才占高度 -->
                        <Border x:Name="TasksBar"
                                Grid.Row="2"
                                Background="{DynamicResource Ap.PanelBg}"
                                BorderBrush="{DynamicResource Ap.DividerSoft}"
                                BorderThickness="0,0,0,1"
                                Visibility="Collapsed">
                                <StackPanel>
                                        <ToggleButton x:Name="TasksToggle"
                                                      Style="{StaticResource SectionHeaderToggle}"
                                                      Click="TasksHeader_Click"
                                                      ToolTip="点击展开 / 收起任务清单">
                                                <Grid x:Name="TasksHeader"
                                                      Height="34">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <prim:Icon Grid.Column="0"
                                                                   x:Name="TasksChevron"
                                                                   IconName="chevron-right"
                                                                   Width="11"
                                                                   Height="11"
                                                                   Margin="12,0,0,0"
                                                                   Foreground="{DynamicResource Ap.IconDim}"
                                                                   VerticalAlignment="Center"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                                <prim:Icon.RenderTransform>
                                                                        <RotateTransform Angle="0"/>
                                                                </prim:Icon.RenderTransform>
                                                        </prim:Icon>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="任务清单"
                                                                   Margin="8,0,0,0"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Ap.FgStrong}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   x:Name="TasksCount"
                                                                   Text="0 / 0"
                                                                   Margin="9,0,0,0"
                                                                   Style="{StaticResource TdMono}"
                                                                   VerticalAlignment="Center"/>
                                                        <Grid Grid.Column="4"
                                                              Width="120"
                                                              Height="4"
                                                              VerticalAlignment="Center"
                                                              ToolTip="任务完成进度">
                                                                <Border Background="{DynamicResource Ap.TrackBg}"
                                                                        CornerRadius="2"/>
                                                                <Grid ClipToBounds="True">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition x:Name="TasksFillCol"
                                                                                                  Width="0*"/>
                                                                                <ColumnDefinition x:Name="TasksRestCol"
                                                                                                  Width="1*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0"
                                                                                Background="{DynamicResource Ap.BarGrad}"
                                                                                CornerRadius="2"/>
                                                                </Grid>
                                                        </Grid>
                                                        <TextBlock Grid.Column="5"
                                                                   x:Name="TasksPct"
                                                                   Text="0%"
                                                                   Margin="9,0,12,0"
                                                                   Style="{StaticResource TdMono}"
                                                                   VerticalAlignment="Center"/>
                                                </Grid>
                                        </ToggleButton>
                                        <StackPanel x:Name="TasksDetail"
                                                    Visibility="{Binding IsChecked, ElementName=TasksToggle, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl x:Name="TodoPanel"
                                                              ItemsSource="{Binding Todos}"
                                                              Margin="6,0,6,8">
                                                        <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Grid Margin="0,2,0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Grid Grid.Column="0"
                                                                                      Width="14">
                                                                                        <TextBlock Text="{Binding Marker}"
                                                                                                   FontSize="11.5"
                                                                                                   Foreground="{DynamicResource Ap.Accent}"
                                                                                                   VerticalAlignment="Top">
                                                                                                <TextBlock.Style>
                                                                                                        <Style TargetType="TextBlock">
                                                                                                                <Style.Triggers>
                                                                                                                        <DataTrigger Binding="{Binding IsInProgress}"
                                                                                                                                     Value="True">
                                                                                                                                <Setter Property="Visibility"
                                                                                                                                        Value="Collapsed"/>
                                                                                                                        </DataTrigger>
                                                                                                                </Style.Triggers>
                                                                                                        </Style>
                                                                                                </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <prim:Icon IconName="spinner"
                                                                                                   Width="11"
                                                                                                   Height="11"
                                                                                                   Margin="1,3,0,0"
                                                                                                   HorizontalAlignment="Left"
                                                                                                   VerticalAlignment="Top"
                                                                                                   Foreground="{DynamicResource Ap.Accent}"
                                                                                                   RenderTransformOrigin="0.5,0.5">
                                                                                                <prim:Icon.RenderTransform>
                                                                                                        <RotateTransform/>
                                                                                                </prim:Icon.RenderTransform>
                                                                                                <prim:Icon.Style>
                                                                                                        <Style TargetType="prim:Icon">
                                                                                                                <Setter Property="Visibility"
                                                                                                                        Value="Collapsed"/>
                                                                                                                <Style.Triggers>
                                                                                                                        <DataTrigger Binding="{Binding IsInProgress}"
                                                                                                                                     Value="True">
                                                                                                                                <Setter Property="Visibility"
                                                                                                                                        Value="Visible"/>
                                                                                                                        </DataTrigger>
                                                                                                                </Style.Triggers>
                                                                                                        </Style>
                                                                                                </prim:Icon.Style>
                                                                                                <prim:Icon.Triggers>
                                                                                                        <EventTrigger RoutedEvent="Loaded">
                                                                                                                <BeginStoryboard Storyboard="{StaticResource Ap.Spin}"/>
                                                                                                        </EventTrigger>
                                                                                                </prim:Icon.Triggers>
                                                                                        </prim:Icon>
                                                                                </Grid>
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding Text}"
                                                                                           TextWrapping="Wrap"
                                                                                           FontSize="11.5"
                                                                                           LineHeight="17"
                                                                                           LineStackingStrategy="BlockLineHeight">
                                                                                        <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                        <Setter Property="Foreground"
                                                                                                                Value="{DynamicResource Ap.NoteFg}"/>
                                                                                                        <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding IsCompleted}"
                                                                                                                             Value="True">
                                                                                                                        <Setter Property="TextDecorations"
                                                                                                                                Value="Strikethrough"/>
                                                                                                                        <Setter Property="Foreground"
                                                                                                                                Value="{DynamicResource Ap.FgFaint}"/>
                                                                                                                </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                </Style>
                                                                                        </TextBlock.Style>
                                                                                </TextBlock>
                                                                        </Grid>
                                                                </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                        </StackPanel>
                                </StackPanel>
                        </Border>


                        <!-- ══════════════════ CHAT ══════════════════ -->
                        <!--
                                用 ListBox 而不是「ScrollViewer + ItemsControl」：
                                后者会把**所有**消息的视觉树一次性建出来，长会话的内存与布局成本线性增长；
                                ListBox 自带 ScrollViewer，能启用 VirtualizingStackPanel 只实例化可见项
                                这里把它当纯展示用：去掉选择高亮、边框与焦点虚线
                        -->
                        <Grid Grid.Row="3">
                                <ListBox x:Name="ChatScroll"
                                         ItemsSource="{Binding Messages}"
                                         ItemTemplateSelector="{StaticResource MessageSelector}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="16,14,12,12"
                                         Focusable="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel">
                                        <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel/>
                                                </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding"
                                                                Value="0"/>
                                                        <Setter Property="Margin"
                                                                Value="0"/>
                                                        <Setter Property="Background"
                                                                Value="Transparent"/>
                                                        <Setter Property="BorderThickness"
                                                                Value="0"/>
                                                        <Setter Property="FocusVisualStyle"
                                                                Value="{x:Null}"/>
                                                        <Setter Property="HorizontalContentAlignment"
                                                                Value="Stretch"/>
                                                        <Setter Property="Template">
                                                                <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                                <ContentPresenter/>
                                                                        </ControlTemplate>
                                                                </Setter.Value>
                                                        </Setter>
                                                </Style>
                                        </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!--
                                ══════════════════ 主页（当前会话没有消息时显示） ══════════════════
                                打开工具窗口先看到它，而不是直接跳进上次的会话：让用户自己决定继续哪一个，
                                顺便把常用动作摆到眼前
                                -->
                                <ScrollViewer x:Name="HomePanel"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="20,24,18,18"
                                              Visibility="Visible">
                                        <StackPanel>
                                                <!--
                                                        欢迎页：**不显示 Logo，也不显示项目名**（工具窗口本身已由 VS 标注，
                                                        再重复一遍是噪音）只留一句普通文字的价值主张，不做卡片化
                                                -->
                                                <TextBlock Text="把你的编程任务交给它：自己读代码、改文件、跑命令，每一步改动都先问过你"
                                                           TextWrapping="Wrap"
                                                           FontSize="13.5"
                                                           LineHeight="24"
                                                           LineStackingStrategy="BlockLineHeight"
                                                           Foreground="{DynamicResource Ap.FgBody}"/>

                                                <TextBlock Text="快捷开始"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="0,22,0,10"
                                                           Foreground="{DynamicResource Ap.FgFaint}"/>
                                                <!-- 两列卡片网格（图标 + 标题 + 一句说明），替代原先挤在换行里的小胶囊 -->
                                                <UniformGrid x:Name="HomeActions"
                                                             Columns="2"
                                                             HorizontalAlignment="Stretch"/>

                                                <TextBlock Text="最近的会话"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="0,22,0,8"
                                                           Foreground="{DynamicResource Ap.FgFaint}"/>
                                                <!-- 一个会话一行：标题与元信息都能看全 -->
                                                <StackPanel x:Name="HomeRecents"/>
                                                <TextBlock x:Name="HomeEmptyHint"
                                                           Text="还没有历史会话 —— 在下面的输入框里说说你想做什么吧"
                                                           TextWrapping="Wrap"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Ap.FgFaint}"/>
                                        </StackPanel>
                                </ScrollViewer>

                                <!--
                                        用户往上翻看历史时，流式输出不再把他拽回底部；
                                        这里给一个出口，让他自己决定什么时候跟回最新消息
                                -->
                                <Button x:Name="JumpToBottomBtn"
                                        Style="{StaticResource ActButton}"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,18,16"
                                        ToolTip="回到最新消息"
                                        Click="JumpToBottom_Click">
                                        <StackPanel Orientation="Horizontal">
                                                <prim:Icon IconName="chevron-down"
                                                           Width="11"
                                                           Height="11"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="回到底部"
                                                           Style="{StaticResource ActLabel}"
                                                           Margin="5,0,0,0"/>
                                        </StackPanel>
                                </Button>
                        </Grid>

                        <!-- ══════════════════ 本次会话更改的文件 ══════════════════ -->
                        <!-- 只在本次会话真的改过文件时出现；点头部展开逐文件明细，点文件名在 VS 里打开 -->
                        <Border x:Name="SummaryBar"
                                Grid.Row="4"
                                Background="{DynamicResource Ap.FooterBg}"
                                BorderBrush="{DynamicResource Ap.DividerSoft}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding HasSessionChanges, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                        <ToggleButton x:Name="SummaryToggle"
                                                      Style="{StaticResource SectionHeaderToggle}"
                                                      Click="SummaryHeader_Click"
                                                      ToolTip="点击展开 / 收起本次变更的文件">
                                                <Grid x:Name="SummaryHeader"
                                                      Height="32">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <prim:Icon Grid.Column="0"
                                                                   x:Name="SummaryChevron"
                                                                   IconName="chevron-right"
                                                                   Width="11"
                                                                   Height="11"
                                                                   Margin="12,0,0,0"
                                                                   Foreground="{DynamicResource Ap.IconDim}"
                                                                   VerticalAlignment="Center"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                                <prim:Icon.RenderTransform>
                                                                        <RotateTransform Angle="0"/>
                                                                </prim:Icon.RenderTransform>
                                                        </prim:Icon>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="本次变更"
                                                                   Margin="8,0,0,0"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Ap.FgStrong}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding ChangedAddLabel}"
                                                                   Margin="0,0,10,0"
                                                                   Style="{StaticResource TdMono}"
                                                                   Foreground="{DynamicResource Ap.Teal}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding ChangedDelLabel}"
                                                                   Margin="0,0,10,0"
                                                                   Style="{StaticResource TdMono}"
                                                                   Foreground="{DynamicResource Ap.Red}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5"
                                                                   Text="{Binding ChangedFileLabel}"
                                                                   Margin="0,0,12,0"
                                                                   Style="{StaticResource TdMono}"
                                                                   Foreground="{DynamicResource Ap.FgDim}"
                                                                   VerticalAlignment="Center"/>
                                                </Grid>
                                        </ToggleButton>
                                        <StackPanel x:Name="SummaryDetail"
                                                    Visibility="{Binding IsChecked, ElementName=SummaryToggle, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl ItemsSource="{Binding SessionChanges}"
                                                              Margin="6,0,6,8">
                                                        <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Grid Margin="2,3">
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.Column="0"
                                                                                        Width="14"
                                                                                        Height="14"
                                                                                        CornerRadius="3"
                                                                                        BorderThickness="1">
                                                                                        <Border.Style>
                                                                                                <Style TargetType="Border">
                                                                                                        <Setter Property="Background"
                                                                                                                Value="{DynamicResource Ap.AccentSoftWeak}"/>
                                                                                                        <Setter Property="BorderBrush"
                                                                                                                Value="{DynamicResource Ap.AccentBorder}"/>
                                                                                                        <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding Kind}"
                                                                                                                             Value="{x:Static models:SessionChangeKind.Add}">
                                                                                                                        <Setter Property="Background"
                                                                                                                                Value="{DynamicResource Ap.TealSoftWeak}"/>
                                                                                                                        <Setter Property="BorderBrush"
                                                                                                                                Value="{DynamicResource Ap.TealBorder}"/>
                                                                                                                </DataTrigger>
                                                                                                                <DataTrigger Binding="{Binding Kind}"
                                                                                                                             Value="{x:Static models:SessionChangeKind.Delete}">
                                                                                                                        <Setter Property="Background"
                                                                                                                                Value="{DynamicResource Ap.RedSoft}"/>
                                                                                                                        <Setter Property="BorderBrush"
                                                                                                                                Value="{DynamicResource Ap.RedBorderSoft}"/>
                                                                                                                </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                </Style>
                                                                                        </Border.Style>
                                                                                        <TextBlock Text="{Binding Marker}"
                                                                                                   FontSize="9"
                                                                                                   FontWeight="Bold"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Foreground="{DynamicResource Ap.FgDim}"/>
                                                                                </Border>
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding Path}"
                                                                                           Margin="8,0,0,0"
                                                                                           Style="{StaticResource TdMono}"
                                                                                           Foreground="{DynamicResource Ap.CodeFg}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center"
                                                                                           Cursor="Hand"
                                                                                           ToolTip="点击在 Visual Studio 中打开"
                                                                                           MouseLeftButtonUp="SummaryPath_Click"/>
                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="{Binding StatLabel}"
                                                                                           Margin="10,0,0,0"
                                                                                           Style="{StaticResource TdMono}"
                                                                                           Foreground="{DynamicResource Ap.FgDim}"
                                                                                           VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                        </StackPanel>
                                </StackPanel>
                        </Border>


                        <!-- ══════════════════ COMPOSER ══════════════════ -->
                        <Border Grid.Row="5"
                                Background="{DynamicResource Ap.Bg}"
                                BorderBrush="{DynamicResource Ap.DividerSoft}"
                                BorderThickness="0,1,0,0"
                                Padding="12,8,12,12">
                                <StackPanel>
                                        <!--
                                                ══════════════════ 统一审批区（对齐 UIUX 模板 .appr） ══════════════════
                                                有待批动作时单独占一块：暖色提示 + 卡片（标题 / 目标 / 详情）+「拒绝 / 批准并继续」
                                                放在输入框上方的固定位置 —— 待批卡片可能在滚动区外，按钮跟着卡片跑会点不到
                                                内容由 RefreshApprovalPanel() 按当前待批动作填充
                                        -->
                                        <Border x:Name="ApprovalPanel"
                                                Visibility="Collapsed"
                                                Margin="0,0,0,8"
                                                Background="{DynamicResource Ap.WarnPanelBg}"
                                                BorderBrush="{DynamicResource Ap.WarnPanelBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="11,9,11,11">
                                                <StackPanel>
                                                        <!-- 头部：待审批操作 + 计数徽标 -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,0,0,8">
                                                                <prim:Icon IconName="problem"
                                                                           Width="11"
                                                                           Height="11"
                                                                           Foreground="{DynamicResource Ap.Warn}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="待审批操作"
                                                                           Margin="6,0,0,0"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Ap.Warn}"
                                                                           VerticalAlignment="Center"/>
                                                                <Border Margin="7,0,0,0"
                                                                        Padding="5,1"
                                                                        Background="{DynamicResource Ap.WarnSoft}"
                                                                        BorderBrush="{DynamicResource Ap.WarnBorder}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="3"
                                                                        VerticalAlignment="Center">
                                                                        <TextBlock x:Name="ApprovalCount"
                                                                                   Text="1 项"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource Ap.WarnText}"/>
                                                                </Border>
                                                        </StackPanel>

                                                        <!-- 审批卡：图标 + 标题 + 元信息 / 详情 / 动作 -->
                                                        <Border Background="{DynamicResource Ap.BgCard}"
                                                                BorderBrush="{DynamicResource Ap.Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="7">
                                                                <StackPanel>
                                                                        <Grid Margin="11,10">
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <prim:Icon x:Name="ApprovalIcon"
                                                                                           Grid.Column="0"
                                                                                           IconName="edit"
                                                                                           Width="13"
                                                                                           Height="13"
                                                                                           Foreground="{DynamicResource Ap.FgFaint}"
                                                                                           VerticalAlignment="Center"/>
                                                                                <TextBlock x:Name="ApprovalTitle"
                                                                                           Grid.Column="1"
                                                                                           Text=""
                                                                                           Margin="8,0,0,0"
                                                                                           FontSize="12.5"
                                                                                           Foreground="{DynamicResource Ap.FgStrong}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center"/>
                                                                                <TextBlock x:Name="ApprovalMeta"
                                                                                           Grid.Column="2"
                                                                                           Text=""
                                                                                           Margin="8,0,0,0"
                                                                                           MaxWidth="150"
                                                                                           FontSize="10.5"
                                                                                           FontFamily="{DynamicResource Ap.FontCode}"
                                                                                           Foreground="{DynamicResource Ap.WarnText}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center"/>
                                                                        </Grid>

                                                                        <!-- 查看详情：展开差异 / 目标内容（.apr-toggle） -->
                                                                        <Button x:Name="ApprovalToggle"
                                                                                Style="{StaticResource ApprovalToggle}"
                                                                                Visibility="Collapsed"
                                                                                Click="ApprovalToggle_Click">
                                                                                <StackPanel Orientation="Horizontal"
                                                                                            HorizontalAlignment="Center">
                                                                                        <TextBlock x:Name="ApprovalToggleLabel"
                                                                                                   Text="查看详情"
                                                                                                   FontSize="11"
                                                                                                   Foreground="{DynamicResource Ap.FgFaint}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                        <prim:Icon x:Name="ApprovalChevron"
                                                                                                   IconName="chevron-down"
                                                                                                   Width="9"
                                                                                                   Height="9"
                                                                                                   Margin="5,0,0,0"
                                                                                                   Foreground="{DynamicResource Ap.FgFaint}"
                                                                                                   RenderTransformOrigin="0.5,0.5"
                                                                                                   VerticalAlignment="Center">
                                                                                                <prim:Icon.RenderTransform>
                                                                                                        <RotateTransform Angle="0"/>
                                                                                                </prim:Icon.RenderTransform>
                                                                                        </prim:Icon>
                                                                                </StackPanel>
                                                                        </Button>

                                                                        <!-- 详情：差异卡给 diff 行，操作确认卡给纯文本 -->
                                                                        <Border x:Name="ApprovalDetail"
                                                                                Visibility="Collapsed"
                                                                                BorderBrush="{DynamicResource Ap.DividerSoft}"
                                                                                BorderThickness="0,1,0,0">
                                                                                <ScrollViewer MaxHeight="220"
                                                                                              HorizontalScrollBarVisibility="Disabled"
                                                                                              VerticalScrollBarVisibility="Auto">
                                                                                        <Grid>
                                                                                                <ItemsControl x:Name="ApprovalDiff"
                                                                                                              Margin="0,2,0,2"
                                                                                                              ItemTemplate="{StaticResource DiffLineTemplate}"/>
                                                                                                <TextBlock x:Name="ApprovalDetailText"
                                                                                                           Margin="11,8,11,9"
                                                                                                           Visibility="Collapsed"
                                                                                                           TextWrapping="Wrap"
                                                                                                           FontFamily="{DynamicResource Ap.FontCode}"
                                                                                                           FontSize="11.5"
                                                                                                           Foreground="{DynamicResource Ap.FgDim}"/>
                                                                                        </Grid>
                                                                                </ScrollViewer>
                                                                        </Border>

                                                                        <!-- 动作：拒绝 / 批准并继续（各占一半宽） -->
                                                                        <Grid Margin="11,8,11,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="6"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button x:Name="ApprovalRejectBtn"
                                                                                        Grid.Column="0"
                                                                                        Style="{StaticResource ActReject}"
                                                                                        Height="28"
                                                                                        Click="ApprovalReject_Click">
                                                                                        <TextBlock Text="拒绝"
                                                                                                   Style="{StaticResource ActLabel}"/>
                                                                                </Button>
                                                                                <Button x:Name="ApprovalApproveBtn"
                                                                                        Grid.Column="2"
                                                                                        Style="{StaticResource ActPrimary}"
                                                                                        Height="28"
                                                                                        Click="ApprovalApprove_Click">
                                                                                        <StackPanel Orientation="Horizontal"
                                                                                                    HorizontalAlignment="Center">
                                                                                                <prim:Icon IconName="check"
                                                                                                           Width="11"
                                                                                                           Height="11"
                                                                                                           VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="批准并继续"
                                                                                                           Margin="5,0,0,0"
                                                                                                           Style="{StaticResource ActLabel}"/>
                                                                                        </StackPanel>
                                                                                </Button>
                                                                        </Grid>
                                                                </StackPanel>
                                                        </Border>
                                                </StackPanel>
                                        </Border>

                                        <!--
                                                请求条：需要拍板 / 有可撤销的改动 / 生成中排队时，才出现在输入框上方
                                                显示哪些动作由 Models/RequestBar.cs 的纯逻辑决定（自检直接断言那段判定）
                                                「审批」动作已单独交给上方统一审批区，这里只出其余动作
                                        -->
                                        <StackPanel x:Name="RequestBarPanel"
                                                    Visibility="Collapsed"
                                                    Margin="0,0,0,8">
                                                <Border Background="{DynamicResource Ap.AccentSoft}"
                                                        BorderBrush="{DynamicResource Ap.Accent}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10,9">
                                                        <StackPanel>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="0,0,10,0">
                                                                                <TextBlock x:Name="RequestTitle"
                                                                                           Text=""
                                                                                           FontSize="12"
                                                                                           TextWrapping="Wrap"
                                                                                           Foreground="{DynamicResource Ap.FgBright}"/>
                                                                                <TextBlock x:Name="RequestDetail"
                                                                                           Text=""
                                                                                           Visibility="Collapsed"
                                                                                           FontSize="11"
                                                                                           TextWrapping="Wrap"
                                                                                           Margin="0,2,0,0"
                                                                                           Foreground="{DynamicResource Ap.FgFaint}"/>
                                                                        </StackPanel>
                                                                        <StackPanel x:Name="RequestButtons"
                                                                                    Grid.Column="1"
                                                                                    Orientation="Horizontal"
                                                                                    VerticalAlignment="Center"/>
                                                                </Grid>

                                                                <!--
                                                                        快捷键提示：与 Input_PreviewKeyDown 的绑定保持一致，
                                                                        让「按什么键能做什么」不必靠猜
                                                                -->
                                                                <TextBlock x:Name="RequestKeys"
                                                                           Margin="0,6,0,0"
                                                                           FontSize="10.5"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource Ap.FgFaint}"
                                                                           Text="Enter 接受 · Esc 拒绝 · Ctrl+Z 撤销本轮改动"/>

                                                                <!-- 通栏动作（生成中的「取消」）单独占一行并横向铺满 -->
                                                                <StackPanel x:Name="RequestWide"
                                                                            Margin="0,8,0,0"/>
                                                        </StackPanel>
                                                </Border>
                                        </StackPanel>

                                        <!-- 任务完成后出现在输入框上方：横向铺满的「开始新任务」 -->
                                        <Button x:Name="NewTaskBtn"
                                                Style="{StaticResource BtnPrimary}"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Stretch"
                                                Height="34"
                                                Margin="0,0,0,8"
                                                Click="NewTask_Click"
                                                ToolTip="清空当前会话，开始一个新任务">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                        <prim:Icon IconName="plus"
                                                                   Width="13"
                                                                   Height="13"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="开始新任务"
                                                                   Margin="6,0,0,0"
                                                                   FontSize="12.5"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                                </StackPanel>
                                        </Button>

                                        <Border x:Name="InputBox"
                                                Background="{DynamicResource Ap.BgInput}"
                                                BorderBrush="{DynamicResource Ap.InputBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel>
                                                        <!--
                                                            @ 提及芯片：选中的文件 / 文件夹以「图标 + 名称」显示，
                                                            发送时再还原成 @路径（见 ComposeInputText）有芯片才显示
                                                        -->
                                                        <WrapPanel x:Name="MentionBar"
                                                                   Margin="8,6,8,0"
                                                                   Visibility="Collapsed"/>
                                                        <!-- 粘贴的图片缩略片（多模态）：有图才显示，发送后清空 -->
                                                        <StackPanel x:Name="AttachmentBar"
                                                                    Orientation="Horizontal"
                                                                    Margin="8,6,8,0"/>
                                                        <TextBox x:Name="Input"
                                                                 Style="{StaticResource ChatInput}"
                                                                 MinHeight="52"
                                                                 MaxHeight="150"
                                                                 AllowDrop="True"
                                                                 PreviewDragOver="Input_PreviewDragOver"
                                                                 Drop="Input_Drop"
                                                                 TextChanged="Input_TextChanged"
                                                                 PreviewKeyDown="Input_PreviewKeyDown"/>
                                                        <Grid Margin="8,4,6,6">
                                                                <StackPanel Orientation="Horizontal">
                                                                        <Button x:Name="ModelBtn"
                                                                                Style="{StaticResource ModelButton}"
                                                                                Click="ModelBtn_Click"
                                                                                ToolTip="切换模型">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                        <Ellipse x:Name="ModelDot"
                                                                                                 Width="6"
                                                                                                 Height="6"
                                                                                                 Fill="{DynamicResource Ap.Teal}"
                                                                                                 VerticalAlignment="Center"/>
                                                                                        <TextBlock x:Name="ModelName"
                                                                                                   Text="Claude Sonnet 4.5"
                                                                                                   Margin="6,0,4,0"
                                                                                                   FontSize="11.5"
                                                                                                   VerticalAlignment="Center"
                                                                                                   MaxWidth="150"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                                        <prim:Icon IconName="chevron-down"
                                                                                                   Width="10"
                                                                                                   Height="10"
                                                                                                   Foreground="{DynamicResource Ap.IconDim}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                        </Button>
                                                                        <!-- 只显示图标（@），文字放 ToolTip —— 工具行更紧凑 -->
                                                                        <ToggleButton x:Name="MentionBtn"
                                                                                      Style="{StaticResource IconChipToggle}"
                                                                                      Margin="6,0,0,0"
                                                                                      ToolTip="添加上下文：问题 / 终端 / 网页 / 文件 / 文件夹 / Git Commits (@)"
                                                                                      Click="MentionBtn_Click">
                                                                                <prim:Icon IconName="at"
                                                                                           Width="13"
                                                                                           Height="13"
                                                                                           VerticalAlignment="Center"/>
                                                                        </ToggleButton>
                                                                        <ToggleButton x:Name="AutoChip"
                                                                                      Style="{StaticResource ChipToggle}"
                                                                                      IsChecked="True"
                                                                                      Margin="6,0,0,0"
                                                                                      Click="AutoChip_Click"
                                                                                      ToolTip="按类别自动批准：点击选择哪些操作不用再问你">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                        <prim:Icon IconName="zap-fill"
                                                                                                   Width="10"
                                                                                                   Height="10"
                                                                                                   VerticalAlignment="Center"/>
                                                                                        <!-- 文案由代码按「已放开几类」动态填写（全部批准 / N 项批准 / 不自动批准） -->
                                                                                        <TextBlock x:Name="AutoChipText"
                                                                                                   Text="Auto"
                                                                                                   Margin="5,0,0,0"
                                                                                                   FontSize="11.5"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                                                                </StackPanel>
                                                                        </ToggleButton>
                                                                        <!-- 计划 / 执行：连成一体的二选一分段控件 -->
                                                                        <Border Margin="6,0,0,0"
                                                                                CornerRadius="6"
                                                                                BorderBrush="{DynamicResource Ap.DividerSoft}"
                                                                                BorderThickness="1">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                        <ToggleButton x:Name="PlanChip"
                                                                                                      Style="{StaticResource SegmentLeft}"
                                                                                                      Click="PlanChip_Click"
                                                                                                      ToolTip="计划：只做调研并给出分步计划，不改任何文件">
                                                                                                <StackPanel Orientation="Horizontal">
                                                                                                        <prim:Icon IconName="book"
                                                                                                                   Width="10"
                                                                                                                   Height="10"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                        <TextBlock Text="计划"
                                                                                                                   Margin="5,0,0,0"
                                                                                                                   FontSize="11.5"
                                                                                                                   VerticalAlignment="Center"
                                                                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                                                                                </StackPanel>
                                                                                        </ToggleButton>
                                                                                        <Border Width="1"
                                                                                                Background="{DynamicResource Ap.DividerSoft}"/>
                                                                                        <ToggleButton x:Name="ActChip"
                                                                                                      Style="{StaticResource SegmentRight}"
                                                                                                      Click="ActChip_Click"
                                                                                                      ToolTip="执行：按计划动手修改文件">
                                                                                                <StackPanel Orientation="Horizontal">
                                                                                                        <prim:Icon IconName="zap"
                                                                                                                   Width="10"
                                                                                                                   Height="10"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                        <TextBlock Text="执行"
                                                                                                                   Margin="5,0,0,0"
                                                                                                                   FontSize="11.5"
                                                                                                                   VerticalAlignment="Center"
                                                                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                                                                                </StackPanel>
                                                                                        </ToggleButton>
                                                                                </StackPanel>
                                                                        </Border>
                                                                </StackPanel>
                                                                <!--
                                                                        同一个按钮两种身份：空闲时是「发送」，生成中是「停止」
                                                                        （图标与提示文案在 UpdateSendState() 里切换）
                                                                -->
                                                                <Button x:Name="SendBtn"
                                                                        Style="{StaticResource SendButton}"
                                                                        HorizontalAlignment="Right"
                                                                        AutomationProperties.Name="发送"
                                                                        IsEnabled="False"
                                                                        Click="Send_Click"
                                                                        ToolTip="发送 (Ctrl+Enter)">
                                                                        <prim:Icon x:Name="SendIcon"
                                                                                   IconName="send-up"
                                                                                   Width="13"
                                                                                   Height="13"/>
                                                                </Button>
                                                        </Grid>
                                                </StackPanel>
                                        </Border>

                                        <!--
                            自动批准弹层：与「设置 → 批准」分页同一份类别定义
                                            行由 ApprovalCatalog 在代码里生成（ApprovalRows）
                                        -->
                                        <Popup x:Name="AutoPopup"
                                               PlacementTarget="{Binding ElementName=AutoChip}"
                                               Placement="Top"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               VerticalOffset="-8">
                                                <Border Width="268"
                                                        Background="{DynamicResource Ap.PopoverBg}"
                                                        BorderBrush="{DynamicResource Ap.PopoverBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                        <StackPanel>
                                                                <TextBlock Text="自动批准"
                                                                           Style="{StaticResource TdSectionTitle}"
                                                                           Padding="11,7,10,6"/>
                                                                <Border BorderBrush="{DynamicResource Ap.PopoverDivider}"
                                                                        BorderThickness="0,1,0,0"/>
                                                                <StackPanel x:Name="AutoList"
                                                                            Margin="11,4,11,9"/>
                                                        </StackPanel>
                                                </Border>
                                        </Popup>

                                        <!-- 模型选择弹层 -->
                                        <Popup x:Name="ModelPopup"
                                               PlacementTarget="{Binding ElementName=ModelBtn}"
                                               Placement="Top"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               VerticalOffset="-8">
                                                <Border Width="268"
                                                        Background="{DynamicResource Ap.PopoverBg}"
                                                        BorderBrush="{DynamicResource Ap.PopoverBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                        <StackPanel>
                                                                <TextBlock Text="选择模型"
                                                                           Style="{StaticResource TdSectionTitle}"
                                                                           Padding="11,7,10,6"/>
                                                                <Border BorderBrush="{DynamicResource Ap.PopoverDivider}"
                                                                        BorderThickness="0,1,0,0"/>

                                                                <!--
                                                                        配置档案：用户自己命名的多套连接（AA / BB …）
                                                                        没有档案时整区收起，不占位置
                                                                -->
                                                                <StackPanel x:Name="ProfileSection"
                                                                            Visibility="Collapsed">
                                                                        <TextBlock Text="配置档案"
                                                                                   Style="{StaticResource TdSectionTitle}"
                                                                                   Padding="11,8,10,2"/>
                                                                        <ItemsControl x:Name="ProfileList"
                                                                                      Margin="4"/>
                                                                        <Border BorderBrush="{DynamicResource Ap.PopoverDivider}"
                                                                                BorderThickness="0,1,0,0"
                                                                                Margin="0,6,0,0"/>
                                                                </StackPanel>

                                                                <!--
                                                                        模型列表**数据驱动**（见 Models/ModelCatalog.cs）：
                                                                        要加模型/厂商只改那个目录，不必动这份 XAML
                                                                -->
                                                                <ScrollViewer MaxHeight="360"
                                                                              VerticalScrollBarVisibility="Auto">
                                                                        <ItemsControl x:Name="ModelList"
                                                                                      Margin="4">
                                                                                <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                                <StackPanel>
                                                                                                        <TextBlock Text="{Binding Label}"
                                                                                                                   Style="{StaticResource TdSectionTitle}"
                                                                                                                   Padding="7,8,0,3"/>
                                                                                                        <ItemsControl ItemsSource="{Binding Models}">
                                                                                                                <ItemsControl.ItemTemplate>
                                                                                                                        <DataTemplate>
                                                                                                                                <Button Style="{StaticResource MenuItemButton}"
                                                                                                                                        Tag="{Binding Id}"
                                                                                                                                        Click="ModelItem_Click">
                                                                                                                                        <Grid>
                                                                                                                                                <Grid.ColumnDefinitions>
                                                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                                                </Grid.ColumnDefinitions>
                                                                                                                                                <Ellipse Grid.Column="0"
                                                                                                                                                         Width="6"
                                                                                                                                                         Height="6"
                                                                                                                                                         Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                                                                                                                         VerticalAlignment="Center"/>
                                                                                                                                                <TextBlock Grid.Column="1"
                                                                                                                                                           Text="{Binding DisplayName}"
                                                                                                                                                           Margin="8,0,0,0"
                                                                                                                                                           FontSize="12.5"
                                                                                                                                                           Foreground="{DynamicResource Ap.FgMenu}"
                                                                                                                                                           VerticalAlignment="Center"
                                                                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                                                                <TextBlock Grid.Column="2"
                                                                                                                                                           Text="{Binding ContextLabel}"
                                                                                                                                                           Style="{StaticResource TdCaption}"
                                                                                                                                                           FontFamily="{DynamicResource Ap.FontCode}"
                                                                                                                                                           FontSize="10.5"
                                                                                                                                                           VerticalAlignment="Center"/>
                                                                                                                                        </Grid>
                                                                                                                                </Button>
                                                                                                                        </DataTemplate>
                                                                                                                </ItemsControl.ItemTemplate>
                                                                                                        </ItemsControl>
                                                                                                </StackPanel>
                                                                                        </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                </ScrollViewer>
                                                        </StackPanel>
                                                </Border>
                                        </Popup>

                                        <!-- 提及弹层 -->
                                        <Popup x:Name="MentionPopup"
                                               PlacementTarget="{Binding ElementName=MentionBtn}"
                                               Placement="Top"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               VerticalOffset="-8">
                                                <Border Width="300"
                                                        Background="{DynamicResource Ap.PopoverBg}"
                                                        BorderBrush="{DynamicResource Ap.PopoverBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                        <StackPanel>
                                                                <TextBlock x:Name="MentionTitle"
                                                                           Text="提及"
                                                                           Style="{StaticResource TdSectionTitle}"
                                                                           Padding="11,7,10,6"/>
                                                                <Border BorderBrush="{DynamicResource Ap.PopoverDivider}"
                                                                        BorderThickness="0,1,0,0"/>
                                                                <!--
                                                                    候选来自**当前工作区**的真实文件与目录
                                                                    （WorkspaceIndex 扫描 + 随输入过滤），不再是写死的示例路径
                                                                    条目由代码生成，见 RefreshMentions()
                                                                -->
                                                                <ScrollViewer MaxHeight="300"
                                                                              VerticalScrollBarVisibility="Auto">
                                                                        <!-- 条目由 RefreshMentions() 在代码里生成（StackPanel 便于直接增删） -->
                                                                        <StackPanel x:Name="MentionList"
                                                                                    Margin="4"/>
                                                                </ScrollViewer>
                                                        </StackPanel>
                                                </Border>
                                        </Popup>
                                </StackPanel>
                        </Border>
                </Grid>

                <!-- ══════════════════ 抽屉（覆盖层） ══════════════════ -->
                <tw:HistoryDrawerControl x:Name="HistoryDrawer"
                                         Visibility="Collapsed"/>
                <tw:SettingsDrawerControl x:Name="SettingsDrawer"
                                          Visibility="Collapsed"/>
        </Grid>
</UserControl>
