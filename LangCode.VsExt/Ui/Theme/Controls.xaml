<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:LangCode.VsExt.Ui.Primitive">
 
        <Style x:Key="ApFocusVisual">
                <Setter Property="Control.Template">
                        <Setter.Value>
                                <ControlTemplate>
                                        <Border Margin="1"
                                                BorderBrush="{DynamicResource Ap.FocusBorder}"
                                                BorderThickness="2"
                                                CornerRadius="6"/>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ==================== 文本 ==================== -->
        <Style TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontUi}"/>
                <Setter Property="FontSize"
                        Value="13"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.Fg}"/>
                <Setter Property="TextOptions.TextFormattingMode"
                        Value="Ideal"/>
        </Style>

        <Style x:Key="TdBody"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgBody}"/>
                <Setter Property="LineHeight"
                        Value="21"/>
                <Setter Property="LineStackingStrategy"
                        Value="BlockLineHeight"/>
                <Setter Property="TextWrapping"
                        Value="Wrap"/>
        </Style>

        <Style x:Key="TdCaption"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize"
                        Value="10.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgFaint}"/>
        </Style>

        <Style x:Key="TdSectionTitle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize"
                        Value="10.5"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgFaint}"/>
        </Style>

        <Style x:Key="TdFieldLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgLabel}"/>
        </Style>

        <Style x:Key="TdFieldHint"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize"
                        Value="11"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgFaint}"/>
                <Setter Property="TextWrapping"
                        Value="Wrap"/>
                <Setter Property="LineHeight"
                        Value="16"/>
                <Setter Property="LineStackingStrategy"
                        Value="BlockLineHeight"/>
        </Style>

        <Style x:Key="TdToggleName"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgStrong}"/>
        </Style>

        <Style x:Key="TdToggleDesc"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize"
                        Value="11"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgFaint}"/>
                <Setter Property="TextWrapping"
                        Value="Wrap"/>
                <Setter Property="Margin"
                        Value="0,2,0,0"/>
                <Setter Property="LineHeight"
                        Value="16"/>
                <Setter Property="LineStackingStrategy"
                        Value="BlockLineHeight"/>
        </Style>

        <Style x:Key="TdMono"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontCode}"/>
                <Setter Property="FontSize"
                        Value="11.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgLabel}"/>
        </Style>

        <Style x:Key="TdBrand"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgBright}"/>
        </Style>

        <Style x:Key="TdBadge"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontCode}"/>
                <Setter Property="FontSize"
                        Value="10"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgDim}"/>
                <Setter Property="Padding"
                        Value="2,0"/>
        </Style>

        <Style x:Key="TdLink"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgLabel}"/>
        </Style>

        <!-- ==================== 图标按钮（Header / 抽屉返回） ==================== -->
        <Style x:Key="IconButton"
               TargetType="Button">
                <Setter Property="Width"
                        Value="28"/>
                <Setter Property="Height"
                        Value="28"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource ApFocusVisual}"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.IconMuted}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.White}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgActive}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ==================== 卡片动作按钮（批注 / 拒绝 / 接受 / 继续 / 重试 / 撤销） ==================== -->
        <Style x:Key="ActButton"
               TargetType="Button">
                <Setter Property="Height"
                        Value="22"/>
                <Setter Property="Padding"
                        Value="7,0"/>
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontUi}"/>
                <Setter Property="FontSize"
                        Value="11"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.IconMuted}"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource ApFocusVisual}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Ap.ActBorder}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.FgBright}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="ActAccept"
               TargetType="Button"
               BasedOn="{StaticResource ActButton}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.Teal}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Ap.TealBorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.TealSoft}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.TealText}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="ActReject"
               TargetType="Button"
               BasedOn="{StaticResource ActButton}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.Red}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Ap.RedBorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.RedSoft}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.RedText}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="ActPrimary"
               TargetType="Button"
               BasedOn="{StaticResource ActButton}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.White}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource Ap.AccentHi}"
                                                BorderBrush="{DynamicResource Ap.AccentHi}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.Accent}"/>
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.Accent}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- 卡片头部折叠按钮（只有悬停底色，箭头旋转交给代码隐藏） -->
        <Style x:Key="FoldButton"
               TargetType="Button">
                <Setter Property="Width"
                        Value="20"/>
                <Setter Property="Height"
                        Value="20"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.IconDim}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.FgStrong}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ==================== 通用按钮（底部操作 / 添加服务器 / 导入配置） ==================== -->
        <Style x:Key="BtnBase"
               TargetType="Button">
                <Setter Property="Height"
                        Value="28"/>
                <Setter Property="Padding"
                        Value="12,0"/>
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontUi}"/>
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgMenu}"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Ap.ActBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.ControlBorder}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="BtnPrimary"
               TargetType="Button"
               BasedOn="{StaticResource BtnBase}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.White}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource Ap.AccentHi}"
                                                BorderBrush="{DynamicResource Ap.AccentHi}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.Accent}"/>
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.Accent}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="BtnSmall"
               TargetType="Button"
               BasedOn="{StaticResource BtnBase}">
                <Setter Property="Height"
                        Value="24"/>
                <Setter Property="Padding"
                        Value="9,0"/>
                <Setter Property="FontSize"
                        Value="11.5"/>
        </Style>

        <Style x:Key="BtnDanger"
               TargetType="Button"
               BasedOn="{StaticResource BtnBase}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.Red}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Ap.RedBorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.RedSoft}"/>
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.Red}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ==================== 输入框 ==================== -->
        <Style TargetType="TextBox">
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontUi}"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgStrong}"/>
                <Setter Property="Background"
                        Value="{DynamicResource Ap.ControlBg}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Ap.ControlBorder}"/>
                <Setter Property="CaretBrush"
                        Value="{DynamicResource Ap.FgStrong}"/>
                <Setter Property="SelectionBrush"
                        Value="{DynamicResource Ap.Accent}"/>
                <Setter Property="Padding"
                        Value="9,6"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}"
                                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.FocusBorder}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled"
                                                         Value="False">
                                                        <Setter Property="Opacity"
                                                                Value="0.5"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="ChatInput"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgStrong}"/>
                <Setter Property="FontSize"
                        Value="13"/>
                <Setter Property="Padding"
                        Value="11,9,11,2"/>
                <Setter Property="AcceptsReturn"
                        Value="True"/>
                <Setter Property="TextWrapping"
                        Value="Wrap"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalScrollBarVisibility="Hidden"/>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="SearchInput"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height"
                        Value="30"/>
                <Setter Property="Padding"
                        Value="30,0,9,0"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
        </Style>

        <Style x:Key="FieldControl"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height"
                        Value="30"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <!--
                    高度 30 的表单输入框必须把纵向内边距归零
                    基础样式给的是 Padding="9,6"：30 - 6*2 - 边框 2 = 16px 内容高度，
                    而 12.5px 字号需要约 17px —— 文字会被纵向裁切，
                    表现就是「Base URL / 最大输出那些框里看不见字」
                    SearchInput 一直是这么写的（Padding="30,0,9,0"），这里对齐
                -->
                <Setter Property="Padding"
                        Value="9,0"/>
        </Style>

        <!-- ==================== 下拉框（重写模板，弹层不再出现系统蓝） ==================== -->
        <Style TargetType="ComboBoxItem">
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontUi}"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgMenu}"/>
                <Setter Property="Padding"
                        Value="10,6"/>
                <Setter Property="SnapsToDevicePixels"
                        Value="True"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.ComboItemHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.ComboItemSelected}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style TargetType="ComboBox">
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontUi}"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgStrong}"/>
                <Setter Property="Height"
                        Value="30"/>
                <Setter Property="SnapsToDevicePixels"
                        Value="True"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                                <Border x:Name="Bd"
                                                        Background="{DynamicResource Ap.ControlBg}"
                                                        BorderBrush="{DynamicResource Ap.ControlBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <Grid> 
                                                                <ContentPresenter x:Name="ContentPart"
                                                                                  Margin="9,0,26,0"
                                                                                  HorizontalAlignment="Left"
                                                                                  VerticalAlignment="Center"
                                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                                                <TextBox x:Name="PART_EditableTextBox"
                                                                         Margin="9,0,26,0"
                                                                         VerticalAlignment="Center"
                                                                         VerticalContentAlignment="Center"
                                                                         Visibility="Collapsed"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         Padding="0"
                                                                         Foreground="{TemplateBinding Foreground}"
                                                                         CaretBrush="{TemplateBinding Foreground}"
                                                                         FontFamily="{TemplateBinding FontFamily}"
                                                                         FontSize="{TemplateBinding FontSize}"/>
                                                                <ui:Icon IconName="chevron-down"
                                                                         Width="12"
                                                                         Height="12"
                                                                         Margin="0,0,9,0"
                                                                         HorizontalAlignment="Right"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource Ap.IconDim}"
                                                                         IsHitTestVisible="False"/>
                                                        </Grid>
                                                </Border>
                                                <ToggleButton x:Name="Toggle"
                                                              Focusable="False"
                                                              ClickMode="Press"
                                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                        <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent"/>
                                                                </ControlTemplate>
                                                        </ToggleButton.Template>
                                                </ToggleButton>
                                                <Popup x:Name="PART_Popup"
                                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                                       Focusable="False"
                                                       Placement="Bottom"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Slide"
                                                       MinWidth="{TemplateBinding ActualWidth}"
                                                       MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                        <Border Background="{DynamicResource Ap.PopoverBg}"
                                                                BorderBrush="{DynamicResource Ap.PopoverBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Margin="0,4,0,0"
                                                                Padding="4">
                                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                        <StackPanel IsItemsHost="True"/>
                                                                </ScrollViewer>
                                                        </Border>
                                                </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.FocusBorder}"/>
                                                </Trigger>
                                                <!-- 可编辑下拉：把显示层换成真正的输入框，否则手输内容无处渲染 -->
                                                <Trigger Property="IsEditable"
                                                         Value="True">
                                                        <Setter TargetName="ContentPart"
                                                                Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Setter TargetName="PART_EditableTextBox"
                                                                Property="Visibility"
                                                                Value="Visible"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ==================== 滑块（温度 / Top P / 字号） ==================== -->
        <Style TargetType="Slider">
                <Setter Property="Height"
                        Value="16"/>
                <Setter Property="VerticalAlignment"
                        Value="Center"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Slider">
                                        <Grid VerticalAlignment="Center">
                                                <Border Height="3"
                                                        Background="{DynamicResource Ap.TrackBg}"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Center"/>
                                                <Track x:Name="PART_Track">
                                                        <Track.Thumb>
                                                                <Thumb>
                                                                        <Thumb.Template>
