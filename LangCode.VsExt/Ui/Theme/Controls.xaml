        <Style x:Key="IconChipToggle"
               TargetType="ToggleButton">
                <Setter Property="Width"
                        Value="24"/>
                <Setter Property="Height"
                        Value="24"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.IconMuted}"/>
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource ApFocusVisual}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Ap.ActBorder}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.FgBright}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.AccentSoftWeak}"/>
