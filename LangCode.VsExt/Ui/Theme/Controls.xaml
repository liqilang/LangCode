                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.AccentBorder}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.Accent}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="SendButton"
               TargetType="Button">
                <Setter Property="Width"
                        Value="28"/>
                <Setter Property="Height"
                        Value="28"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.White}"/>
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource ApFocusVisual}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource Ap.AccentHi}"
                                                CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled"
                                                         Value="False">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.DisabledBg}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.FgFaint}"/>
                                                        <Setter Property="Cursor"
                                                                Value="Arrow"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ==================== 设置分页 Tab（RadioButton） ==================== -->
        <Style x:Key="TabButton"
               TargetType="RadioButton">
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontUi}"/>
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="FontWeight"
                        Value="Medium"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgDim}"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Height"
                        Value="38"/>
                <Setter Property="Padding"
                        Value="11,0"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                        <Grid Background="Transparent">
                                                <Border x:Name="Hover"
                                                        Background="Transparent"/>
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                <Border x:Name="Underline"
                                                        Height="2"
                                                        Margin="7,0,7,0"
                                                        VerticalAlignment="Bottom"
                                                        Background="{DynamicResource Ap.Accent}"
                                                        CornerRadius="2,2,0,0"
                                                        Visibility="Collapsed"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Hover"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.FgBright}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked"
                                                         Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.FgBright}"/>
                                                        <Setter TargetName="Underline"
                                                                Property="Visibility"
                                                                Value="Visible"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ==================== 滚动条（细、暗色） ==================== -->
        <Style x:Key="ScrollRepeatButton"
               TargetType="RepeatButton">
                <Setter Property="Focusable"
                        Value="False"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent"/>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style TargetType="ScrollBar">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="Width"
                        Value="10"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent">
                                                <Track x:Name="PART_Track"
                                                       IsDirectionReversed="True">
                                                        <Track.DecreaseRepeatButton>
                                                                <RepeatButton Style="{StaticResource ScrollRepeatButton}"
                                                                              Command="ScrollBar.PageUpCommand"/>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                                <Thumb>
                                                                        <Thumb.Template>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                        <Border x:Name="Th"
                                                                                                Background="{DynamicResource Ap.ScrollThumb}"
                                                                                                CornerRadius="5"
                                                                                                Margin="2,0,2,0"/>
                                                                                        <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsMouseOver"
                                                                                                         Value="True">
                                                                                                        <Setter TargetName="Th"
                                                                                                                Property="Background"
                                                                                                                Value="{DynamicResource Ap.ScrollThumbHover}"/>
                                                                                                </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                        </Thumb.Template>
                                                                </Thumb>
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                                <RepeatButton Style="{StaticResource ScrollRepeatButton}"
                                                                              Command="ScrollBar.PageDownCommand"/>
                                                        </Track.IncreaseRepeatButton>
                                                </Track>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="Orientation"
                                                         Value="Horizontal">
                                                        <Setter Property="Width"
                                                                Value="Auto"/>
                                                        <Setter Property="Height"
                                                                Value="10"/>
                                                        <Setter TargetName="PART_Track"
                                                                Property="IsDirectionReversed"
                                                                Value="False"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ==================== 弹层菜单项（模型 / 提及） ==================== -->
        <Style x:Key="MenuItemButton"
               TargetType="Button">
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="5"
                                                Padding="7,6">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ==================== 密码框（API Key） ====================
             PasswordBox 的**默认模板**在暗色主题下不理会 Foreground：
             文字会跟着系统画笔走，在深色底上直接看不见
             这里重写模板，显式用 TemplateBinding 绑定背景/描边，前景色由样式的
             Foreground 继承给内部的密码文本宿主 -->
        <Style TargetType="PasswordBox">
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontUi}"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgStrong}"/>
                <Setter Property="Background"
                        Value="{DynamicResource Ap.ControlBg}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Ap.ControlBorder}"/>
                <Setter Property="CaretBrush"
                        Value="{DynamicResource Ap.FgStrong}"/>
                <Setter Property="Padding"
                        Value="9,0"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="PasswordBox">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}"
                                                              VerticalAlignment="Center"
                                                              Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.FocusBorder}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!--
        ==================== 提问卡备选答案 ====================
        一行一个、纵向铺满：选项文字往往较长，横排换行会打断阅读
    -->
        <Style x:Key="OptionButton"
               TargetType="Button">
                <Setter Property="HorizontalAlignment"
                        Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Left"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgBody}"/>
                <Setter Property="Margin"
                        Value="0,0,0,5"/>
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource ApFocusVisual}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource Ap.BgInput}"
                                                BorderBrush="{DynamicResource Ap.InputBorder}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="11,8">
                                                <ContentPresenter HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.AccentSoft}"/>
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.AccentBorder}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.FgStrong}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!--
        ==================== 统一审批区：查看详情 ====================
        整行可点的「查看详情 / 收起详情」条：顶部一条分隔线，悬停浅底，内容居中
        对齐 UIUX 模板的 .apr-toggle（箭头旋转由代码驱动，见 ApprovalToggle_Click）
    -->
        <Style x:Key="ApprovalToggle"
               TargetType="Button">
                <Setter Property="Height"
                        Value="26"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource ApFocusVisual}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Ap.DividerSoft}"
                                                BorderThickness="0,1,0,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!--
        ==================== 图标操作按钮 ====================
        卡内动作（在编辑器打开 / 查看差异 / 撤回 / 暂停 / 展开…）只显示图标，
        文字放 ToolTip：hover 才提示 —— 卡片更安静，一屏能多放信息
    -->
        <Style x:Key="IconAction"
               TargetType="Button">
                <Setter Property="Width"
                        Value="26"/>
                <Setter Property="Height"
                        Value="26"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource ApFocusVisual}"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.IconMuted}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgActive}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled"
                                                         Value="False">
                                                        <Setter Property="Opacity"
                                                                Value="0.4"/>
                                                        <Setter Property="Cursor"
                                                                Value="Arrow"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="IconActionDanger"
               TargetType="Button"
               BasedOn="{StaticResource IconAction}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.Red}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.RedSoft}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.RedText}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled"
                                                         Value="False">
                                                        <Setter Property="Opacity"
                                                                Value="0.4"/>
                                                        <Setter Property="Cursor"
                                                                Value="Arrow"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ==================== 多选勾选框（历史批量删除） ==================== -->
        <Style x:Key="MultiCheck"
               TargetType="Border">
                <Setter Property="Width"
                        Value="18"/>
                <Setter Property="Height"
                        Value="18"/>
                <Setter Property="CornerRadius"
                        Value="5"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Ap.InputBorder}"/>
                <Setter Property="Background"
                        Value="Transparent"/>
        </Style>

        <Style x:Key="MultiCheckOn"
               TargetType="Border"
               BasedOn="{StaticResource MultiCheck}">
                <Setter Property="Background"
                        Value="{DynamicResource Ap.Accent}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Ap.Accent}"/>
        </Style>

        <!-- ==================== 历史会话行 ==================== -->
        <Style x:Key="HistoryRow"
               TargetType="Border">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="CornerRadius"
                        Value="8"/>
                <Setter Property="Padding"
                        Value="10"/>
                <Setter Property="Margin"
                        Value="0,0,0,2"/>
                <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Ap.BgHover}"/>
                        </Trigger>
                </Style.Triggers>
        </Style>

        <!-- ==================== 设置分组卡片 ==================== -->
        <Style x:Key="SettingCard"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{DynamicResource Ap.BgCard}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Ap.BorderSoft}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="10"/>
                <Setter Property="Padding"
                        Value="13,2,13,6"/>
                <Setter Property="Margin"
                        Value="0,0,0,14"/>
        </Style>

        <!-- 设置行之间的分隔（两栏行的下半描边） -->
        <Style x:Key="SettingRowDivider"
               TargetType="Border">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Ap.BorderSoft}"/>
                <Setter Property="BorderThickness"
                        Value="0,0,0,1"/>
                <Setter Property="Padding"
                        Value="0,11"/>
        </Style>

        <!-- ==================== 主页「快捷开始」卡片 ==================== -->
        <Style x:Key="HomeCard"
               TargetType="Button">
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch"/>
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource ApFocusVisual}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource Ap.BgCard}"
                                                BorderBrush="{DynamicResource Ap.BorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Top"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.AccentSoft}"/>
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.AccentBorder}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>
 
        <Storyboard x:Key="Ap.Spin"
                    x:Shared="False"
                    RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                 From="0"
                                 To="360"
                                 Duration="0:0:0.9"/>
        </Storyboard>

        <!--
        ==================== 分段表头（上下文 / 任务清单 / 本次变更 共用） ====================
        整行可点的折叠表头：默认透明、悬停浅底，内容左对齐铺满
        用 ToggleButton 而不是 Grid+MouseLeftButtonUp —— 后者在部分宿主里命中/路由不稳定，
        点了没反应；ToggleButton 的点击是标准控件行为，且 IsChecked 可直接驱动明细显隐
    -->
        <Style x:Key="SectionHeaderToggle"
               TargetType="ToggleButton">
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch"/>
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource ApFocusVisual}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!--
        ==================== 进度条渐变（上下文 / 任务清单共用） ====================
        紫 → 蓝，与设计稿的 90deg 渐变一致这份渐变不随主题变化（亮/暗下都成立），
        因此放在共享控件字典里，避免在深浅两套调色板里各写一份
    -->
        <LinearGradientBrush x:Key="Ap.BarGrad"
                             StartPoint="0,0"
                             EndPoint="1,0">
                <GradientStop Offset="0"
                              Color="#FFA371F7"/>
                <GradientStop Offset="1"
                              Color="#FF5B9DFF"/>
        </LinearGradientBrush>

</ResourceDictionary>
