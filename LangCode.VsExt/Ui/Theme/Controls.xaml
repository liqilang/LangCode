        <Style x:Key="ModelButton"
               TargetType="Button">
                <Setter Property="Height"
                        Value="24"/>
                <Setter Property="Padding"
                        Value="8,0,7,0"/>
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontUi}"/>
                <Setter Property="FontSize"
                        Value="11.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.FgLabel}"/>
