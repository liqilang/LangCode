                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.FgBright}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="ChipToggle"
               TargetType="ToggleButton">
                <Setter Property="Height"
                        Value="24"/>
                <Setter Property="Padding"
                        Value="8,0"/>
                <Setter Property="FontFamily"
                        Value="{DynamicResource Ap.FontUi}"/>
                <Setter Property="FontSize"
                        Value="11.5"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource Ap.IconMuted}"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource ApFocusVisual}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Ap.ActBorder}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.BgHover}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.FgBright}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked"
                                                         Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource Ap.TealSoftWeak}"/>
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource Ap.TealBorderSoft}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Ap.Teal}"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
